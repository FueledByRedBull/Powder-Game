#version 430

layout(local_size_x = 256) in;

layout(r8ui, binding = 0) uniform readonly uimage2D boundaryTex;

struct WaterParticle {
    vec4 state0;
    vec4 state1;
    vec4 state2;
};

layout(std430, binding = 0) buffer WaterParticles {
    WaterParticle particles[];
};

uniform ivec2 gridSize;
uniform ivec2 brushCenter;
uniform int brushRadius;
uniform int maxParticles;

bool insideBrush(vec2 position) {
    vec2 delta = position - (vec2(brushCenter) + vec2(0.5));
    return dot(delta, delta) <= float(brushRadius * brushRadius);
}

bool blocked(ivec2 coord) {
    if (coord.x < 0 || coord.y < 0 || coord.x >= gridSize.x || coord.y >= gridSize.y) {
        return true;
    }
    return imageLoad(boundaryTex, coord).r != 0u;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uint(maxParticles)) {
        return;
    }

    WaterParticle particle = particles[index];
    if (particle.state1.x < 0.5) {
        return;
    }

    ivec2 coord = ivec2(floor(particle.state0.xy));
    if (blocked(coord) || insideBrush(particle.state0.xy)) {
        particle.state1.x = 0.0;
        particles[index] = particle;
    }
}
