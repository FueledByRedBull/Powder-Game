#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(rg16f, binding = 0) uniform readonly image2D gasVelocitySrc;
layout(rg16f, binding = 1) uniform readonly image2D gasVelocityFwd;
layout(r16f, binding = 2) uniform readonly image2D smokeDenSrc;
layout(r16f, binding = 3) uniform readonly image2D temperatureSrc;
layout(r16f, binding = 4) uniform readonly image2D fuelSrc;
layout(r16f, binding = 5) uniform readonly image2D oxidizerSrc;
layout(rg16f, binding = 6) uniform readonly image2D reactionSrc;
layout(r16f, binding = 7) uniform readonly image2D smokeDenFwd;
layout(r16f, binding = 8) uniform readonly image2D temperatureFwd;
layout(r16f, binding = 9) uniform readonly image2D fuelFwd;
layout(r16f, binding = 10) uniform readonly image2D oxidizerFwd;
layout(rg16f, binding = 11) uniform readonly image2D reactionFwd;
layout(r16f, binding = 12) uniform writeonly image2D smokeDenDst;
layout(r16f, binding = 13) uniform writeonly image2D temperatureDst;
layout(r16f, binding = 14) uniform writeonly image2D fuelDst;
layout(r16f, binding = 15) uniform writeonly image2D oxidizerDst;
layout(rg16f, binding = 16) uniform writeonly image2D reactionDst;
layout(r8ui, binding = 17) uniform readonly uimage2D boundaryTex;

layout(std430, binding = 7) buffer DebugCounters {
    uint nanInfDetected;
    uint particleOverflowBlocked;
    uint pressureNonconverged;
    uint inactiveTileMisses;
};

uniform ivec2 gasSize;
uniform float dt;
uniform float maxVelocity;
uniform float densityDissipation;
uniform float scalarDissipation;

ivec2 clampCoord(ivec2 coord) {
    return clamp(coord, ivec2(0), gasSize - ivec2(1));
}

bool blocked(ivec2 coord) {
    return imageLoad(boundaryTex, clampCoord(coord)).r != 0u;
}

bool blockedCell(ivec2 cell) {
    return cell.x < 0 || cell.y < 0 || cell.x >= gasSize.x || cell.y >= gasSize.y ||
           imageLoad(boundaryTex, cell).r != 0u;
}

struct TransportStencil {
    ivec2 cells[4];
    vec4 weights;
};

// Traverse crossed cells, stopping before a solid face or a sealed diagonal corner.
vec2 clipTrace(vec2 start, vec2 end) {
    vec2 delta = end - start;
    ivec2 cell = ivec2(floor(start));
    ivec2 direction = ivec2(sign(delta));
    vec2 interval = 1.0 / max(abs(delta), vec2(1e-20));
    vec2 nextEdge = vec2(delta.x >= 0.0 ? float(cell.x + 1) - start.x : start.x - float(cell.x),
                         delta.y >= 0.0 ? float(cell.y + 1) - start.y : start.y - float(cell.y)) * interval;
    for (int crossing = 0; crossing < gasSize.x + gasSize.y + 2; ++crossing) {
        float t = min(nextEdge.x, nextEdge.y);
        if (t > 1.0) return end;
        bool crossX = nextEdge.x <= nextEdge.y;
        bool crossY = nextEdge.y <= nextEdge.x;
        ivec2 nextCell = cell + ivec2(crossX ? direction.x : 0, crossY ? direction.y : 0);
        if ((crossX && blockedCell(cell + ivec2(direction.x, 0))) ||
            (crossY && blockedCell(cell + ivec2(0, direction.y))) || blockedCell(nextCell)) {
            float margin = 0.001 / max(max(abs(delta.x), abs(delta.y)), 1.0);
            return start + delta * max(0.0, t - margin);
        }
        cell = nextCell;
        nextEdge += vec2(crossX ? interval.x : 0.0, crossY ? interval.y : 0.0);
    }
    return start;
}

bool donorOpen(ivec2 cell, int component) {
    if (blockedCell(cell)) return false;
    if (component == 0) return !blockedCell(cell - ivec2(1, 0));
    if (component == 1) return !blockedCell(cell - ivec2(0, 1));
    return true;
}

TransportStencil transportStencil(vec2 start, vec2 end, vec2 offset, ivec2 maximum, int component) {
    vec2 point = clipTrace(start, end);
    vec2 samplePoint = clamp(point - offset, vec2(0.0), vec2(maximum));
    ivec2 base = ivec2(floor(samplePoint));
    vec2 fraction = fract(samplePoint);
    TransportStencil stencil;
    stencil.weights = vec4((1.0 - fraction.x) * (1.0 - fraction.y), fraction.x * (1.0 - fraction.y),
                           (1.0 - fraction.x) * fraction.y, fraction.x * fraction.y);
    for (int i = 0; i < 4; ++i) {
        stencil.cells[i] = clamp(base + ivec2(i & 1, i >> 1), ivec2(0), maximum);
        vec2 donor = vec2(stencil.cells[i]) + offset;
        if (stencil.weights[i] > 0.0 &&
            (!donorOpen(stencil.cells[i], component) || any(notEqual(clipTrace(point, donor), donor)))) {
            stencil.weights[i] = 0.0;
        }
    }
    float total = dot(stencil.weights, vec4(1.0));
    if (total > 0.0) {
        stencil.weights /= total;
    } else {
        // A clipped characteristic with no admissible donor retains its local source value.
        for (int i = 0; i < 4; ++i) stencil.cells[i] = clamp(ivec2(start - offset), ivec2(0), maximum);
        stencil.weights = vec4(1.0, 0.0, 0.0, 0.0);
    }
    return stencil;
}

vec2 sampleVelocitySrc(vec2 position) {
    vec2 p = clamp(position - vec2(0.5), vec2(0.0), vec2(gasSize) - vec2(1.0));
    ivec2 base = ivec2(floor(p));
    vec2 frac = fract(p);
    vec2 v00 = imageLoad(gasVelocitySrc, base).xy;
    vec2 v10 = imageLoad(gasVelocitySrc, clampCoord(base + ivec2(1, 0))).xy;
    vec2 v01 = imageLoad(gasVelocitySrc, clampCoord(base + ivec2(0, 1))).xy;
    vec2 v11 = imageLoad(gasVelocitySrc, clampCoord(base + ivec2(1, 1))).xy;
    return clamp(mix(mix(v00, v10, frac.x), mix(v01, v11, frac.x), frac.y), vec2(-maxVelocity), vec2(maxVelocity));
}

vec2 sampleVelocityFwd(vec2 position) {
    vec2 p = clamp(position - vec2(0.5), vec2(0.0), vec2(gasSize) - vec2(1.0));
    ivec2 base = ivec2(floor(p));
    vec2 frac = fract(p);
    vec2 v00 = imageLoad(gasVelocityFwd, base).xy;
    vec2 v10 = imageLoad(gasVelocityFwd, clampCoord(base + ivec2(1, 0))).xy;
    vec2 v01 = imageLoad(gasVelocityFwd, clampCoord(base + ivec2(0, 1))).xy;
    vec2 v11 = imageLoad(gasVelocityFwd, clampCoord(base + ivec2(1, 1))).xy;
    return clamp(mix(mix(v00, v10, frac.x), mix(v01, v11, frac.x), frac.y), vec2(-maxVelocity), vec2(maxVelocity));
}



float sampleSmokeFwd(TransportStencil stencil) {
    vec4 values;
    for (int i = 0; i < 4; ++i) values[i] = imageLoad(smokeDenFwd, stencil.cells[i]).x;
    return dot(stencil.weights, values);
}



float sampleTemperatureFwd(TransportStencil stencil) {
    vec4 values;
    for (int i = 0; i < 4; ++i) values[i] = imageLoad(temperatureFwd, stencil.cells[i]).x;
    return dot(stencil.weights, values);
}



float sampleFuelFwd(TransportStencil stencil) {
    vec4 values;
    for (int i = 0; i < 4; ++i) values[i] = imageLoad(fuelFwd, stencil.cells[i]).x;
    return dot(stencil.weights, values);
}



float sampleOxidizerFwd(TransportStencil stencil) {
    vec4 values;
    for (int i = 0; i < 4; ++i) values[i] = imageLoad(oxidizerFwd, stencil.cells[i]).x;
    return dot(stencil.weights, values);
}



vec2 sampleReactionFwd(TransportStencil stencil) {
    vec2 value = vec2(0.0);
    for (int i = 0; i < 4; ++i) value += stencil.weights[i] * imageLoad(reactionFwd, stencil.cells[i]).xy;
    return value;
}

float clampLocalSmoke(TransportStencil stencil, float value) {
    float minV = float(1e30), maxV = float(-1e30);
    for (int i = 0; i < 4; ++i) {
        if (stencil.weights[i] > 0.0) {
            float donor = imageLoad(smokeDenSrc, stencil.cells[i]).x;
            minV = min(minV, donor);
            maxV = max(maxV, donor);
        }
    }
    return clamp(value, minV, maxV);
}

float clampLocalTemperature(TransportStencil stencil, float value) {
    float minV = float(1e30), maxV = float(-1e30);
    for (int i = 0; i < 4; ++i) {
        if (stencil.weights[i] > 0.0) {
            float donor = imageLoad(temperatureSrc, stencil.cells[i]).x;
            minV = min(minV, donor);
            maxV = max(maxV, donor);
        }
    }
    return clamp(value, minV, maxV);
}

float clampLocalFuel(TransportStencil stencil, float value) {
    float minV = float(1e30), maxV = float(-1e30);
    for (int i = 0; i < 4; ++i) {
        if (stencil.weights[i] > 0.0) {
            float donor = imageLoad(fuelSrc, stencil.cells[i]).x;
            minV = min(minV, donor);
            maxV = max(maxV, donor);
        }
    }
    return clamp(value, minV, maxV);
}

float clampLocalOxidizer(TransportStencil stencil, float value) {
    float minV = float(1e30), maxV = float(-1e30);
    for (int i = 0; i < 4; ++i) {
        if (stencil.weights[i] > 0.0) {
            float donor = imageLoad(oxidizerSrc, stencil.cells[i]).x;
            minV = min(minV, donor);
            maxV = max(maxV, donor);
        }
    }
    return clamp(value, minV, maxV);
}

vec2 clampLocalReaction(TransportStencil stencil, vec2 value) {
    vec2 minV = vec2(1e30), maxV = vec2(-1e30);
    for (int i = 0; i < 4; ++i) {
        if (stencil.weights[i] > 0.0) {
            vec2 donor = imageLoad(reactionSrc, stencil.cells[i]).xy;
            minV = min(minV, donor);
            maxV = max(maxV, donor);
        }
    }
    return clamp(value, minV, maxV);
}

bool invalid(float value) {
    return isnan(value) || isinf(value);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= gasSize.x || coord.y >= gasSize.y) {
        return;
    }
    if (blocked(coord)) {
        imageStore(smokeDenDst, coord, vec4(0.0));
        imageStore(temperatureDst, coord, vec4(0.0));
        imageStore(fuelDst, coord, vec4(0.0));
        imageStore(oxidizerDst, coord, vec4(0.0));
        imageStore(reactionDst, coord, vec4(0.0));
        return;
    }

    vec2 center = vec2(coord) + vec2(0.5);
    vec2 backtrace = clamp(center - sampleVelocitySrc(center) * dt, vec2(0.5), vec2(gasSize) - vec2(0.5));
    vec2 reverseTrace = clamp(center + sampleVelocityFwd(center) * dt, vec2(0.5), vec2(gasSize) - vec2(0.5));

    TransportStencil backStencil = transportStencil(center, backtrace, vec2(0.5), gasSize - ivec2(1), -1);
    TransportStencil reverseStencil = transportStencil(center, reverseTrace, vec2(0.5), gasSize - ivec2(1), -1);

    float smoke = imageLoad(smokeDenFwd, coord).x + 0.5 * (imageLoad(smokeDenSrc, coord).x - sampleSmokeFwd(reverseStencil));
    float temperature =
        imageLoad(temperatureFwd, coord).x + 0.5 * (imageLoad(temperatureSrc, coord).x - sampleTemperatureFwd(reverseStencil));
    float fuel = imageLoad(fuelFwd, coord).x + 0.5 * (imageLoad(fuelSrc, coord).x - sampleFuelFwd(reverseStencil));
    float oxidizer =
        imageLoad(oxidizerFwd, coord).x + 0.5 * (imageLoad(oxidizerSrc, coord).x - sampleOxidizerFwd(reverseStencil));
    vec2 reaction =
        imageLoad(reactionFwd, coord).xy + 0.5 * (imageLoad(reactionSrc, coord).xy - sampleReactionFwd(reverseStencil));

    // Decay follows the limiter so the original extrema cannot restore it.
    imageStore(smokeDenDst, coord, vec4(clampLocalSmoke(backStencil, smoke) * densityDissipation, 0.0, 0.0, 0.0));
    imageStore(temperatureDst,
               coord,
               vec4(clampLocalTemperature(backStencil, temperature) * scalarDissipation, 0.0, 0.0, 0.0));
    imageStore(fuelDst, coord, vec4(clampLocalFuel(backStencil, fuel) * scalarDissipation, 0.0, 0.0, 0.0));
    imageStore(oxidizerDst,
               coord,
               vec4(clampLocalOxidizer(backStencil, oxidizer) * scalarDissipation, 0.0, 0.0, 0.0));
    reaction = clampLocalReaction(backStencil, reaction);
    reaction.x = 0.0;
    reaction.y = clamp(reaction.y, 0.0, 1.0) * scalarDissipation;
    if (invalid(smoke) || invalid(temperature) || invalid(fuel) || invalid(oxidizer) || invalid(reaction.y)) {
        atomicAdd(nanInfDetected, 1u);
        imageStore(smokeDenDst, coord, vec4(0.0));
        imageStore(temperatureDst, coord, vec4(0.0));
        imageStore(fuelDst, coord, vec4(0.0));
        imageStore(oxidizerDst, coord, vec4(0.0));
        reaction = vec2(0.0);
    }
    imageStore(reactionDst, coord, vec4(reaction, 0.0, 0.0));
}
