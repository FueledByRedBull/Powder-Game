#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(r16f, binding = 0) uniform readonly image2D waterUFaceTex;
layout(r16f, binding = 1) uniform readonly image2D waterVFaceTex;
layout(r16f, binding = 2) uniform writeonly image2D divergenceTex;
layout(r8ui, binding = 3) uniform readonly uimage2D boundaryTex;
layout(r16f, binding = 4) uniform readonly image2D liquidPhiTex;

layout(std430, binding = 7) buffer DebugCounters {
    uint nanInfDetected;
    uint particleOverflowBlocked;
    uint pressureNonconverged;
    uint inactiveTileMisses;
};

uniform ivec2 gridSize;
uniform float liquidPhiThreshold;
uniform float gravityDelta;

bool liquidCell(ivec2 coord) {
    return imageLoad(liquidPhiTex, coord).x < liquidPhiThreshold;
}

float forcedV(ivec2 face) {
    if (face.y == 0 || face.y == gridSize.y ||
        imageLoad(boundaryTex, face - ivec2(0, 1)).r != 0u || imageLoad(boundaryTex, face).r != 0u) {
        return 0.0;
    }
    return imageLoad(waterVFaceTex, face).x + gravityDelta;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= gridSize.x || coord.y >= gridSize.y) {
        return;
    }

    if (imageLoad(boundaryTex, coord).r != 0u || !liquidCell(coord)) {
        imageStore(divergenceTex, coord, vec4(0.0));
        return;
    }

    float u_left = imageLoad(waterUFaceTex, ivec2(coord.x, coord.y)).x;
    float u_right = imageLoad(waterUFaceTex, ivec2(coord.x + 1, coord.y)).x;
    float v_down = forcedV(ivec2(coord.x, coord.y));
    float v_up = forcedV(ivec2(coord.x, coord.y + 1));

    float divergence = (u_right - u_left) + (v_up - v_down);
    if (isnan(divergence) || isinf(divergence) || abs(divergence) > 65504.0) {
        atomicAdd(nanInfDetected, 1u);
        divergence = 0.0;
    }
    imageStore(divergenceTex, coord, vec4(divergence, 0.0, 0.0, 0.0));
}
