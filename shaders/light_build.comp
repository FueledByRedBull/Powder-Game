#version 430

// Emitted light of the fire, one texel per 4x4 cells of the render fields. The host generates the mip chain after this
// pass and composite.frag reads a few levels of it for a wide, soft glow. Presentation only: it reads the render
// fields and writes nothing the simulation uses.

layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba16f, binding = 0) uniform writeonly image2D lightTex;

uniform sampler2D temperatureTex;
uniform sampler2D fireEmissiveTex;
uniform ivec2 lightSize;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= lightSize.x || coord.y >= lightSize.y) {
        return;
    }
    vec2 uv = (vec2(coord) + 0.5) / vec2(lightSize);
    vec2 texel = 1.0 / vec2(textureSize(temperatureTex, 0));
    // The centre of a light texel is a corner of the source cells, so four bilinear taps one cell off it are exactly
    // the mean of its 4x4 footprint.
    float flame = 0.0;
    float temperature = 0.0;
    for (int i = 0; i < 4; ++i) {
        vec2 offset = vec2(float(i & 1) * 2.0 - 1.0, float(i >> 1) * 2.0 - 1.0) * texel;
        flame += texture(fireEmissiveTex, uv + offset).r;
        temperature += texture(temperatureTex, uv + offset).r;
    }
    flame = clamp(flame * 0.25, 0.0, 1.0);
    temperature = clamp(temperature * 0.25, 0.0, 1.0);
    // Light comes from the flame; only very hot gas adds a little. Hotter reads whiter.
    vec3 warm = mix(vec3(1.0, 0.22, 0.03), vec3(1.0, 0.52, 0.16), clamp(flame * 1.2, 0.0, 1.0));
    imageStore(lightTex, coord, vec4(warm * (8.0 * flame + 1.0 * pow(temperature, 4.0)), 0.0));
}
