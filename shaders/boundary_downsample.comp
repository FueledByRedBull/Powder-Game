#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(r8ui, binding = 0) uniform readonly uimage2D srcBoundaryTex;
layout(r8ui, binding = 1) uniform writeonly uimage2D dstBoundaryTex;

uniform ivec2 srcSize;
uniform ivec2 dstSize;
uniform int scale;

bool inBounds(ivec2 coord, ivec2 size) {
    return coord.x >= 0 && coord.y >= 0 && coord.x < size.x && coord.y < size.y;
}

void main() {
    ivec2 dst = ivec2(gl_GlobalInvocationID.xy);
    if (!inBounds(dst, dstSize)) {
        return;
    }

    ivec2 src_min = max(dst * scale - ivec2(1), ivec2(0));
    ivec2 src_max = min(dst * scale + ivec2(scale + 1), srcSize);

    uint blocked = 0u;
    for (int y = src_min.y; y < src_max.y && blocked == 0u; ++y) {
        for (int x = src_min.x; x < src_max.x; ++x) {
            if (imageLoad(srcBoundaryTex, ivec2(x, y)).r != 0u) {
                blocked = 1u;
                break;
            }
        }
    }

    imageStore(dstBoundaryTex, dst, uvec4(blocked, 0u, 0u, 0u));
}
