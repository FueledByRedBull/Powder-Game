#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform usampler2D srcBoundaryTex;
layout(r8ui, binding = 1) uniform writeonly uimage2D dstBoundaryTex;
layout(binding = 2) uniform sampler2D liquidVolumeTex;  // water plus oil volume per source cell
layout(binding = 3) uniform sampler2D oilTex;          // x: oil share of that liquid (oil_field.comp)

uniform ivec2 srcSize;
uniform ivec2 dstSize;
uniform int scale;
// Water (not oil) volume per source cell from which a gas cell counts as under water: a filled gas cell is closed to
// the gas like dense sand, so smoke and flame cannot pass through a pool and smoke that reaches it is washed out.
// Zero (unset) leaves water open.
uniform float waterBlockVolume;

// Sampled reads keep imageLoad's result outside the texture: zero.
vec4 loadTexel(sampler2D t, ivec2 c) {
    return all(lessThan(uvec2(c), uvec2(textureSize(t, 0)))) ? texelFetch(t, c, 0) : vec4(0.0);
}
uvec4 loadTexel(usampler2D t, ivec2 c) {
    return all(lessThan(uvec2(c), uvec2(textureSize(t, 0)))) ? texelFetch(t, c, 0) : uvec4(0u);
}

bool inBounds(ivec2 coord, ivec2 size) {
    return coord.x >= 0 && coord.y >= 0 && coord.x < size.x && coord.y < size.y;
}

void main() {
    ivec2 dst = ivec2(gl_GlobalInvocationID.xy);
    if (!inBounds(dst, dstSize)) {
        return;
    }

    ivec2 src_min = max(dst * scale - ivec2(1), ivec2(0));
    ivec2 src_max = min(dst * scale + ivec2(scale + 1), srcSize);

    // 1: a painted wall in the footprint; 3: dense sand only, which the gas pressure solve treats as porous.
    uint blocked = 0u;
    for (int y = src_min.y; y < src_max.y && blocked != 1u; ++y) {
        for (int x = src_min.x; x < src_max.x; ++x) {
            uint source = loadTexel(srcBoundaryTex, ivec2(x, y)).r;
            if (source == 1u) {
                blocked = 1u;
                break;
            }
            if (source == 3u) blocked = 3u;
        }
    }
    // 3 as well when water fills every source cell the gas cell covers (not its one-cell halo, so the gas cell over a
    // pool's surface stays open and the water there still meets the hot gas above it). Oil is fuel and stays open.
    if (blocked == 0u && waterBlockVolume > 0.0) {
        bool submerged = true;
        for (int i = 0; i < scale * scale && submerged; ++i) {
            ivec2 cell = min(dst * scale + ivec2(i % scale, i / scale), srcSize - 1);
            submerged = loadTexel(liquidVolumeTex, cell).x * (1.0 - loadTexel(oilTex, cell).x) >= waterBlockVolume;
        }
        if (submerged) blocked = 3u;
    }

    imageStore(dstBoundaryTex, dst, uvec4(blocked, 0u, 0u, 0u));
}
