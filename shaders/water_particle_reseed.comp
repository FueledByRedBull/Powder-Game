#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(r8ui, binding = 0) uniform readonly uimage2D boundaryTex;
layout(r16f, binding = 1) uniform readonly image2D liquidVolumeTex;
layout(rg16f, binding = 2) uniform readonly image2D waterVelocityTex;

struct WaterParticle {
    vec4 state0;
    vec4 state1;
    vec4 state2;
};

layout(std430, binding = 0) buffer WaterParticles {
    WaterParticle particles[];
};

layout(std430, binding = 1) buffer WaterSpawnCursor {
    uint spawnCursor;
};

layout(std430, binding = 2) readonly buffer WaterCellCounts {
    uint counts[];
};

layout(std430, binding = 3) buffer DebugCounters {
    uint nanInfDetected;
    uint particleOverflowBlocked;
    uint pressureNonconverged;
    uint inactiveTileMisses;
};

uniform ivec2 gridSize;
uniform float amountThreshold;
uniform float particleMass;
uniform float weightScale;
uniform int targetParticlesPerCell;
uniform int maxSpawnPerCell;
uniform int maxParticles;
uniform uint frameIndex;

int linearIndex(ivec2 coord) {
    return coord.y * gridSize.x + coord.x;
}

uint hashU32(uint value) {
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return value;
}

float hashFloat(uint seed) {
    return float(hashU32(seed) & 0x00FFFFFFu) / float(0x01000000u);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= gridSize.x || coord.y >= gridSize.y) {
        return;
    }
    if (imageLoad(boundaryTex, coord).r != 0u) {
        return;
    }

    float amount = imageLoad(liquidVolumeTex, coord).x;
    if (amount < amountThreshold) {
        return;
    }

    int cell_index = linearIndex(coord);
    float particle_equivalent = float(counts[cell_index]) / weightScale;
    if (particle_equivalent <= 0.0) {
        return;
    }
    if (particle_equivalent >= float(targetParticlesPerCell)) {
        return;
    }

    int spawn_count = min(int(ceil(float(targetParticlesPerCell) - particle_equivalent)), maxSpawnPerCell);
    vec2 velocity = imageLoad(waterVelocityTex, coord).xy;
    uint base_seed = uint(cell_index) ^ (frameIndex * 1664525u + 1013904223u);

    for (int i = 0; i < spawn_count; ++i) {
        uint seed = hashU32(base_seed + uint(i) * 2246822519u);
        vec2 jitter = vec2(hashFloat(seed), hashFloat(seed ^ 0x9e3779b9u)) * 0.56 - vec2(0.28);
        uint slot = atomicAdd(spawnCursor, 1u);
        if (slot >= uint(maxParticles)) {
            atomicAdd(particleOverflowBlocked, 1u);
            return;
        }
        particles[slot].state0 = vec4(vec2(coord) + vec2(0.5) + jitter, velocity);
        particles[slot].state1 = vec4(1.0, particleMass, 0.0, 0.0);
        particles[slot].state2 = vec4(0.0);
    }
}
