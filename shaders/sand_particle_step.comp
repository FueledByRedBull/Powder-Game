#version 430

layout(local_size_x = 256) in;

layout(r16f, binding = 0) uniform readonly image2D boundarySdfTex;
layout(rg32f, binding = 1) uniform readonly image2D sandVelocityTex;
// Sleeping grains per cell (sand_pack.comp): moving grains collide with packed cells like with walls.
layout(r8ui, binding = 2) uniform readonly uimage2D packedTex;
layout(r16f, binding = 3) uniform readonly image2D waterAmountTex;

layout(std430, binding = 7) buffer DebugCounters {
    uint nanInfDetected;
    uint particleOverflowBlocked;
    uint pressureNonconverged;
    uint inactiveTileMisses;
};

struct SandParticle {
    vec4 state0;
    vec4 state1;
    vec4 state2;
    vec4 state3;
};

layout(std430, binding = 0) buffer SandParticles {
    SandParticle particles[];
};

// The grid update has read this substep's node mass: each grain zeroes its stencil's nodes (every deposit came from
// the same stencil), so the next transfer starts from zero without a per-substep clear.
layout(std430, binding = 1) writeonly buffer SandGridMass {
    uint gridMass[];
};

uniform ivec2 gridSize;
uniform float dt;
uniform float restitution;
uniform float maxVelocity;
uniform int maxParticles;
uniform float shearModulus;
uniform float lameLambda;
uniform float frictionAlpha;
// Relative spread of the per-grain friction: alpha * (1 + frictionVariation * trait), trait in [-1, 1] (state2.w).
uniform float frictionVariation;
// Contact damping rate (1/s) of confined sand: full below volume ratio J 0.85, none above 0.95.
uniform float contactDamping;
// mu(I) rheology (Jop et al. 2006): alpha (1 + frictionRateGain I / (inertialI0 + I)), with the inertial number
// I = shear rate * grainDiameter / sqrt(pressure / referenceDensity).
uniform float frictionRateGain;
uniform float inertialI0;
uniform float grainDiameter;
uniform float referenceDensity;
// Wet-sand cohesion: the log volume strain of compression the cone widens by at full capillary strength.
uniform float cohesion;
// Plastic strain (the hardening state q) over which the capillary cohesion of a grain decays by e: liquid bridges break as
// the grains shear or pull apart, so damp sand fails along cracks and shear bands into clumps.
uniform float cohesionSoftening;
// Largest remembered dilation (log volume): dense over loose random packing.
uniform float maxDilation;
// Moisture relaxes up toward the water fill around the grain at wettingRate and dries at dryingRate (1/s). moistureDt is
// the tick's dt on its first substep and 0 on the others: moisture advances once per tick, above the float rounding.
uniform float wettingRate;
uniform float dryingRate;
uniform float moistureDt;
uniform float waterFullVolume;

bool blockedCell(ivec2 cell) {
    return cell.x < 0 || cell.y < 0 || cell.x >= gridSize.x || cell.y >= gridSize.y ||
           imageLoad(boundarySdfTex, cell).x <= 0.0 || imageLoad(packedTex, cell).r > 0u;
}

float sweepGrid(vec2 position, vec2 displacement, out vec2 hitNormal, out ivec2 lastCell) {
    float hitTime = 1.0;
    hitNormal = vec2(0.0);
    for (int axis = 0; axis < 2; ++axis) {
        if (displacement[axis] == 0.0) {
            continue;
        }
        // The domain edge is the outer face of the edge cells, like a painted wall's face.
        float edge = displacement[axis] > 0.0 ? float(gridSize[axis]) : 0.0;
        float time = (edge - position[axis]) / displacement[axis];
        if (time <= hitTime) {
            if (time < hitTime) {
                hitNormal = vec2(0.0);
            }
            hitNormal[axis] = -sign(displacement[axis]);
            hitTime = time;
        }
    }

    ivec2 cell = ivec2(floor(position));
    lastCell = cell;
    ivec2 direction = ivec2(sign(displacement));
    vec2 nextCross = vec2(1e30);
    for (int axis = 0; axis < 2; ++axis) {
        if (direction[axis] != 0) {
            float edge = float(cell[axis] + (direction[axis] > 0 ? 1 : 0));
            nextCross[axis] = (edge - position[axis]) / displacement[axis];
        }
    }

    // Traverse occupied cells by sign; the approximate SDF magnitude is not a safe step length.
    for (int crossing = 0; crossing < gridSize.x + gridSize.y + 2; ++crossing) {
        float time = min(nextCross.x, nextCross.y);
        if (time > hitTime) {
            break;
        }
        bvec2 crossed = lessThanEqual(nextCross, nextCross.yx);
        ivec2 target = cell + ivec2(crossed.x ? direction.x : 0, crossed.y ? direction.y : 0);
        vec2 normal = vec2(0.0);
        if (crossed.x && blockedCell(cell + ivec2(direction.x, 0))) {
            normal.x = -float(direction.x);
        }
        if (crossed.y && blockedCell(cell + ivec2(0, direction.y))) {
            normal.y = -float(direction.y);
        }
        if (all(equal(normal, vec2(0.0))) && blockedCell(target)) {
            normal = vec2(crossed.x ? -float(direction.x) : 0.0,
                          crossed.y ? -float(direction.y) : 0.0);
        }
        if (any(notEqual(normal, vec2(0.0)))) {
            hitNormal = normal + (time == hitTime ? hitNormal : vec2(0.0));
            return time;
        }
        cell = target;
        lastCell = cell;
        // Refer to the original segment instead of accumulating roundoff over a long sweep.
        for (int axis = 0; axis < 2; ++axis) {
            if (crossed[axis]) {
                float edge = float(cell[axis] + (direction[axis] > 0 ? 1 : 0));
                nextCross[axis] = (edge - position[axis]) / displacement[axis];
            }
        }
    }
    return hitTime;
}

void moveWithCollisions(inout vec2 position, inout vec2 velocity, inout mat2 affine,
                        vec2 displacement, float bounce) {
    position = clamp(position, vec2(0.0), vec2(gridSize) - vec2(1.0 / 256.0));
    // A particle already inside painted geometry waits for the brush's explicit clearing.
    if (blockedCell(ivec2(floor(position)))) {
        velocity = vec2(0.0);
        affine = mat2(0.0);
        return;
    }

    // Each contact removes one inward displacement component; the remaining tangent is swept again.
    for (int contact = 0; contact < 2; ++contact) {
        vec2 normal;
        ivec2 openCell;
        float time = sweepGrid(position, displacement, normal, openCell);
        position += displacement * time;
        position += normal * 0.0001;
        // Rounding in the hit point can land a contact (or an edge-grazing move) a few ulps inside the next cell,
        // which may be a wall, where the grain would stick. Keep it in the last open cell the sweep traversed.
        if (any(notEqual(ivec2(floor(position)), openCell))) {
            position = clamp(position, vec2(openCell), vec2(openCell + ivec2(1)) - vec2(1.0 / 256.0));
        }
        if (all(equal(normal, vec2(0.0)))) {
            return;
        }
        displacement *= 1.0 - time;
        for (int axis = 0; axis < 2; ++axis) {
            if (normal[axis] != 0.0) {
                displacement[axis] = 0.0;
                if (velocity[axis] * normal[axis] < 0.0) {
                    velocity[axis] *= -bounce;
                }
                affine[0][axis] = 0.0;
                affine[1][axis] = 0.0;
            }
        }
    }
}

void quadraticWeights(float x, out vec3 w) {
    float d0 = 1.5 - x;
    float d1 = x - 1.0;
    float d2 = x - 0.5;
    w.x = 0.5 * d0 * d0;
    w.y = 0.75 - d1 * d1;
    w.z = 0.5 * d2 * d2;
}

mat2 gatherGridVelocity(vec2 position, out vec2 velocity, out mat2 velocityGradient) {
    vec2 samplePos = position - vec2(0.5);
    ivec2 base = ivec2(floor(samplePos - vec2(0.5)));
    vec2 fx = samplePos - vec2(base);
    vec3 wx;
    vec3 wy;
    quadraticWeights(fx.x, wx);
    quadraticWeights(fx.y, wy);
    vec3 dx = vec3(fx.x - 1.5, -2.0 * (fx.x - 1.0), fx.x - 0.5);
    vec3 dy = vec3(fx.y - 1.5, -2.0 * (fx.y - 1.0), fx.y - 0.5);

    velocity = vec2(0.0);
    velocityGradient = mat2(0.0);
    mat2 affine = mat2(0.0);
    for (int j = 0; j < 3; ++j) {
        for (int i = 0; i < 3; ++i) {
            ivec2 cell = base + ivec2(i, j);
            if (any(lessThan(cell, ivec2(-1))) || any(greaterThan(cell, gridSize))) {
                continue;
            }
            float weight = wx[i] * wy[j];
            vec2 value = imageLoad(sandVelocityTex, cell + ivec2(1)).xy;
            gridMass[(cell.y + 1) * (gridSize.x + 2) + cell.x + 1] = 0u;
            vec2 delta = vec2(cell) + vec2(0.5) - position;
            velocity += weight * value;
            affine += 4.0 * weight * outerProduct(value, delta);
            velocityGradient += outerProduct(value, vec2(dx[i] * wy[j], wx[i] * dy[j]));
        }
    }
    return affine;
}

bool invalid(float value) {
    return isnan(value) || isinf(value);
}

// Nearest rotation of a degenerate deformation; identity when none can be extracted.
mat2 rotationOf(mat2 deformation) {
    vec2 rotation = vec2(deformation[0][0] + deformation[1][1], deformation[0][1] - deformation[1][0]);
    float length2 = dot(rotation, rotation);
    if (!(length2 > 1e-12) || isinf(length2)) return mat2(1.0);
    rotation *= inversesqrt(length2);
    return mat2(rotation, vec2(-rotation.y, rotation.x));
}

// exp(a) for a 2x2 matrix. dF/dt = grad(v) F integrated over a substep is exp(dt grad(v)) F, whose determinant
// exp(dt trace) stays positive; the forward-Euler I + dt grad(v) inverts once an impact makes dt |grad(v)| ~ 1.
mat2 matrixExp(mat2 a) {
    float half_trace = 0.5 * (a[0][0] + a[1][1]);
    mat2 b = a - mat2(half_trace);
    // b is traceless, so b * b = -det(b) I.
    float d = -determinant(b);
    float r = sqrt(abs(d));
    float c;
    float s;
    if (d > 0.0) {
        c = cosh(r);
        s = sinh(r) / r;
    } else if (d < 0.0) {
        c = cos(r);
        s = sin(r) / r;
    } else {
        c = 1.0;
        s = 1.0;
    }
    return exp(half_trace) * (mat2(c) + s * b);
}

// Drucker-Prager return mapping in log strain with volume correction (Klar et al. 2016). volumeCorrection is the
// dilation (log volume) a tip projection dropped: the grain must recover it before it bears load again, so loose sand
// compacts instead of forgetting that it expanded. cohesion >= 0 (a log volume strain) widens the cone by that much
// compression: Mohr-Coulomb shear strength at zero pressure with a tension cut-off, a simplified Tampubolon et al. 2017
// (2 grains per cell cannot carry the tensile stress of a shifted apex: it fractured and flattened damp columns).
// 0 is cohesion-free dry sand. alpha rises with the inertial number (mu(I), Jop et al. 2006).
// plasticStrain receives the increment of the hardening state q: the plastic strain the projection removed (Klar et al.
// 2016: ||strain|| at the tip, the deviatoric cut delta on the cone).
bool projectDeformation(mat2 deformation, float alpha, float shearRate, float cohesion, inout float volumeCorrection,
                        out mat2 projected, out float plasticStrain) {
    plasticStrain = 0.0;
    float volume = determinant(deformation);
    vec2 rotation = vec2(deformation[0][0] + deformation[1][1], deformation[0][1] - deformation[1][0]);
    float rotationLength = length(rotation);
    if (!(volume > 0.0) || invalid(volume) || !(rotationLength > 0.0) || invalid(rotationLength)) return false;
    rotation /= rotationLength;
    mat2 polar = mat2(rotation, vec2(-rotation.y, rotation.x));
    mat2 symmetric = transpose(polar) * deformation;
    vec2 difference = vec2(symmetric[0][0] - symmetric[1][1], symmetric[0][1] + symmetric[1][0]);
    float radius = length(difference);
    float angle = radius > 0.0 ? 0.5 * atan(difference.y, difference.x) : 0.0;
    vec2 axis = vec2(cos(angle), sin(angle));
    mat2 right = mat2(axis, vec2(-axis.y, axis.x));
    vec2 stretch;
    stretch.x = 0.5 * (symmetric[0][0] + symmetric[1][1] + radius);
    stretch.y = volume / stretch.x;
    if (any(lessThanEqual(stretch, vec2(0.0))) || invalid(stretch.x) || invalid(stretch.y)) return false;
    vec2 strain = log(stretch);
    float spent = volumeCorrection;
    // The grain's log volume change since rest: elastic part plus the remembered dilation.
    float trace = strain.x + strain.y + spent;
    if (trace > 0.0) {
        // Separated: stress-free (liquid bridges break too); the grain remembers the dilation up to the dilatancy
        // limit. Past loose packing the grains are apart, and a deeper memory let MPM's volume drift overpack poured
        // piles fourfold.
        volumeCorrection = min(trace, maxDilation);
        plasticStrain = length(strain);
        projected = polar;
        return true;
    }
    volumeCorrection = 0.0;
    vec2 deviator = strain - 0.5 * (strain.x + strain.y);
    float norm = length(deviator);
    // Kirchhoff pressure of the 2D Hencky model, (lambda + mu) times the compressive volume strain.
    float pressure = max(-(lameLambda + shearModulus) * trace, 0.0);
    float rate = shearRate * grainDiameter;
    float inertial = rate > 0.0 ? rate / (rate + inertialI0 * sqrt(pressure / referenceDensity)) : 0.0;  // I / (I0 + I)
    float slope = alpha * (1.0 + frictionRateGain * inertial);
    float delta = norm + (lameLambda + shearModulus) / shearModulus * slope * (trace - cohesion);
    // Keep compressed states inside the cone, including zero deviatoric strain.
    if (delta <= 0.0 && spent == 0.0) {
        projected = deformation;
        return true;
    }
    plasticStrain = min(max(delta, 0.0), norm);
    vec2 projectedStretch = exp(0.5 * trace + (norm == 0.0 ? vec2(0.0) : deviator * (1.0 - max(delta, 0.0) / norm)));
    projected = polar * right * mat2(projectedStretch.x, 0.0, 0.0, projectedStretch.y) * transpose(right);
    return !invalid(projected[0][0]) && !invalid(projected[0][1]) &&
           !invalid(projected[1][0]) && !invalid(projected[1][1]) && determinant(projected) > 0.0;
}

// Capillary cohesion of a moisture fraction: none dry, full from 10% moisture on, gone again at saturation where the
// liquid bridges merge (Mitarai and Nori 2006).
float capillary(float moisture) {
    return clamp(10.0 * moisture, 0.0, 1.0) * clamp(10.0 * (1.0 - moisture), 0.0, 1.0);
}

// Klar et al. 2016 friction hardening: phi_F = h0 + (h1 q - h3) exp(-h2 q) with h0 35, h1 9, h2 0.2, h3 10 degrees:
// fresh sand starts 10 degrees weaker, peaks near q 6 (48 degrees) and settles back to h0. In 2D sin(phi) = sqrt(2) alpha,
// so alpha scales by sin(phi_F) / sin(h0) and frictionAlpha stays the calibrated large-strain value.
float hardening(float q) {
    const float kDegrees = 0.0174532925;
    return sin(kDegrees * (35.0 + (9.0 * q - 10.0) * exp(-0.2 * q))) / sin(kDegrees * 35.0);
}

// state1.x is 1 + the still-tick timer (an integer, sand_sleep.comp) plus q / (q + kHardeningScale) in the fraction.
const float kHardeningScale = 4.0;

// Varies per substep (the host passes a counter), so the same grain rounds differently each time.
uniform uint roundSeed;

// timer + fraction as a float. Where the float's step is coarse (timer 16 and up: grains that have been still a while,
// the sleep timer counts to 255, step 1.5e-5), increments below half a step would round away every substep and slow
// creep would never harden. There the sum is rounded stochastically: the exact error of the nearest float (timer >= 1 >
// fraction, so the subtraction is exact) as a share of the step is the chance of rounding the other way, so the
// expectation is exact. Finer steps keep round-to-nearest: counting the increments below 6e-8 toughened the damp column
// of sand-wet, which shed a median 0.085 of its grains over 12 perturbed runs against 0.2-0.3 the wet-sand fracture was
// tuned with (sand-hardening covers the coarse steps).
float roundStochastically(float timer, float fraction, vec2 position, vec2 velocity) {
    float nearest = timer + fraction;
    float error = fraction - (nearest - timer);
    float step = uintBitsToFloat((floatBitsToUint(nearest) & 0x7f800000u) - (23u << 23));
    if (step < 1e-6) return nearest;
    uint h = floatBitsToUint(position.x) * 1664525u + floatBitsToUint(position.y) * 22695477u +
             floatBitsToUint(velocity.x) * 2654435761u + floatBitsToUint(velocity.y) * 3266489917u + roundSeed * 2246822519u;
    h ^= h >> 16; h *= 2146121005u; h ^= h >> 15; h *= 2221713035u; h ^= h >> 16;
    return float(h >> 8) * (1.0 / 16777216.0) < abs(error) / step ? nearest + sign(error) * step : nearest;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uint(maxParticles)) {
        return;
    }

    SandParticle particle = particles[index];
    if (particle.state1.x < 0.5) {
        return;
    }

    vec2 position = particle.state0.xy;
    vec2 velocity = particle.state0.zw;
    float volumeCorrection = particle.state2.z;
    float timer = floor(particle.state1.x);
    float hardened = particle.state1.x - timer;
    float q = kHardeningScale * hardened / (1.0 - hardened);

    vec2 gridVelocity;
    mat2 velocityGradient;
    mat2 affine = gatherGridVelocity(position, gridVelocity, velocityGradient);
    velocity = gridVelocity;
    // Compressed grains are in enduring contact with their neighbours; the contacts dissipate their motion.
    float volume = determinant(mat2(particle.state3.xy, particle.state3.zw));
    float confined = volume < 0.95 ? min((0.95 - volume) / 0.1, 1.0) : 0.0;  // NaN F: undamped (repaired below)
    // state2.w: the friction trait as an integer in [-31, 31] plus the moisture in the fraction [0, 1).
    float trait = floor(particle.state2.w);
    float moisture = particle.state2.w - trait;
    // Liquid bridges dissipate as they stretch and break (Herminghaus 2005): damp grains are damped like confined ones.
    confined = max(confined, capillary(moisture));
    float retained = exp(-contactDamping * confined * dt);
    velocity *= retained;
    affine *= retained;
    float speed = length(velocity);
    if (speed > maxVelocity && speed > 0.0) {
        velocity *= maxVelocity / speed;
    }

    vec2 displacement = velocity * dt;
    if (invalid(position.x) || invalid(position.y) || invalid(velocity.x) || invalid(velocity.y) ||
        invalid(displacement.x) || invalid(displacement.y) || !(volumeCorrection >= 0.0) || invalid(volumeCorrection) ||
        invalid(affine[0][0]) || invalid(affine[0][1]) || invalid(affine[1][0]) || invalid(affine[1][1])) {
        atomicAdd(nanInfDetected, 1u);
        particle.state1.x = 0.0;
        particles[index] = particle;
        return;
    }

    if (moistureDt > 0.0) {
        // A dense body's own cells hold no liquid, so the wettest cell around the grain sets its saturation.
        ivec2 cell = ivec2(floor(position));
        float fill = 0.0;
        for (int j = -1; j <= 1; ++j) {
            for (int i = -1; i <= 1; ++i) {
                fill = max(fill, imageLoad(waterAmountTex, clamp(cell + ivec2(i, j), ivec2(0), gridSize - ivec2(1))).x);
            }
        }
        float saturation = clamp(fill / waterFullVolume, 0.0, 1.0);
        float rate = saturation > moisture ? wettingRate : dryingRate;
        moisture = min(mix(saturation, moisture, exp(-rate * moistureDt)), 0.999);
    }

    mat2 strainRate = 0.5 * (velocityGradient + transpose(velocityGradient));
    mat2 shear = strainRate - mat2(0.5 * (strainRate[0][0] + strainRate[1][1]));
    float shearRate = sqrt(2.0) * length(vec4(shear[0], shear[1]));  // gamma-dot: the rate of simple shear
    mat2 deformation;
    mat2 trial = matrixExp(dt * velocityGradient) * mat2(particle.state3.xy, particle.state3.zw);
    float alpha = frictionAlpha * (1.0 + frictionVariation * clamp(trait / 31.0, -1.0, 1.0)) * hardening(q);
    float bond = cohesion * capillary(moisture) * exp(-q / cohesionSoftening);
    float plasticStrain;
    if (!projectDeformation(trial, alpha, shearRate, bond, volumeCorrection, deformation, plasticStrain)) {
        // Non-finite (the exponential cannot invert): count it, reset the elastic state to its rotation and keep moving.
        atomicAdd(nanInfDetected, 1u);
        deformation = rotationOf(trial);
        volumeCorrection = 0.0;
        plasticStrain = 0.0;
    }
    q += plasticStrain;
    // The fraction shares a float with the sleep timer, so its step grows to 1.5e-5: rounded stochastically (above).
    particle.state1.x = roundStochastically(timer, min(q / (q + kHardeningScale), 0.9999), position, velocity);
    moveWithCollisions(position, velocity, affine, displacement, restitution);

    particle.state0 = vec4(position, velocity);
    particle.state1.zw = vec2(affine[0][0], affine[0][1]);
    particle.state2 = vec4(affine[1][0], affine[1][1], volumeCorrection, trait + moisture);
    particle.state3 = vec4(deformation[0], deformation[1]);
    particles[index] = particle;
}
