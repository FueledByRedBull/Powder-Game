#version 430

layout(local_size_x = 256) in;

struct SandParticle {
    vec4 state0;
    vec4 state1;
    vec4 state2;
    vec4 state3;
};

layout(std430, binding = 0) buffer SandParticles {
    SandParticle particles[];
};

uniform ivec2 brushCenter;
uniform int brushRadius;
uniform int maxParticles;

// A particle is cleared with the cell it occupies, matching the cell-centre test of the grid clears.
bool insideBrush(vec2 position) {
    vec2 delta = floor(position) - vec2(brushCenter);
    return dot(delta, delta) <= float(brushRadius * brushRadius);
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uint(maxParticles)) {
        return;
    }

    SandParticle particle = particles[index];
    if (particle.state1.x < 0.5) {
        return;
    }
    if (!insideBrush(particle.state0.xy)) {
        return;
    }

    particle.state1.x = 0.0;
    particles[index] = particle;
}
