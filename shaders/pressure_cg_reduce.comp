#version 430

layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Vectors { vec4 vectors[]; };
struct Partial { vec4 values; uvec4 bounds; };
layout(std430, binding = 1) buffer Partials { Partial partials[]; };
layout(std430, binding = 2) buffer Scalars {
    float rho;
    float alpha;
    float beta;
    float residualMax;
    uint running;
    uint invalidInput;
    uint iterations;
    uint finishedGroups;
    uvec4 liquidBounds;
};
layout(std430, binding = 3) buffer DebugCounters {
    uint nanInfDetected;
    uint particleOverflowBlocked;
    uint pressureNonconverged;
    uint inactiveTileMisses;
};
// The tile list of pressure_cg.comp, reset here for the solve's phase 8.
layout(std430, binding = 4) buffer Tiles {
    uvec4 tileDispatch;
    uvec4 tileInfo;
    uint tiles[];
};

uniform int cellCount;
uniform int partialCount;
uniform ivec2 gridSize;
uniform ivec2 solveOrigin;
uniform ivec2 solveSize;
uniform float residualThreshold;
// The start of a solve, after pressure_cg.comp phase 0: per-workgroup partials (0), then their final reduction (1),
// which forms rho and decides whether the solve runs. Later reductions finish inside pressure_cg.comp.
uniform int phase;
// 1: a restart of a converged solve from its true residual b - Ap (RunWaterProjection), which keeps the iteration
// count and the tile list of the solve it continues.
uniform int restart;
shared vec4 totals[256];
shared uvec4 bounds[256];

bool invalid(float value) { return isnan(value) || isinf(value); }

void main() {
    uint lane = gl_LocalInvocationID.x;
    bool finalReduction = phase != 0;
    vec4 total = vec4(0.0);
    uvec4 extent = uvec4(uvec2(gridSize), uvec2(0));
    if (finalReduction) {
        for (uint i = lane; i < uint(partialCount); i += 256u) {
            vec4 item = partials[i].values;
            total.x += item.x;
            total.yz = max(total.yz, item.yz);
            extent.xy = min(extent.xy, partials[i].bounds.xy);
            extent.zw = max(extent.zw, partials[i].bounds.zw);
        }
    } else {
        uint invocation = gl_GlobalInvocationID.x;
        if (invocation < uint(cellCount)) {
            ivec2 cell = solveOrigin + ivec2(int(invocation) % solveSize.x, int(invocation) / solveSize.x);
            uint index = uint(cell.y * gridSize.x + cell.x);
            vec4 value = vectors[index];
            if (any(isnan(value)) || any(isinf(value)) || value.w < 0.0) {
                total.z = 1.0;
            } else {
                total.x = value.w > 0.0 ? value.x * value.z : 0.0;
                total.y = abs(value.x);
                if (value.w > 0.0 || value.x != 0.0) extent = uvec4(cell, cell);
            }
        }
    }
    totals[lane] = total;
    bounds[lane] = extent;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (lane < stride) {
            totals[lane].x += totals[lane + stride].x;
            totals[lane].yz = max(totals[lane].yz, totals[lane + stride].yz);
            bounds[lane].xy = min(bounds[lane].xy, bounds[lane + stride].xy);
            bounds[lane].zw = max(bounds[lane].zw, bounds[lane + stride].zw);
        }
        barrier();
    }
    if (lane != 0u) return;
    total = totals[0];
    if (!finalReduction) {
        partials[gl_WorkGroupID.x].values = total;
        partials[gl_WorkGroupID.x].bounds = bounds[0];
        return;
    }
    rho = total.x;
    alpha = beta = 0.0;
    invalidInput = finishedGroups = 0u;
    liquidBounds = bounds[0];
    if (restart == 0) {
        iterations = 0u;
        tileDispatch = uvec4(0u, 1u, 1u, 0u);
        tileInfo = uvec4(0u);
    }
    residualMax = total.y;
    bool nonfinite = total.z != 0.0 || invalid(total.x) || invalid(total.y);
    // A start leaves margin for the independent true-residual check after the solve; a restart is that same check of
    // b - Ap, so a pressure that already passes it is kept unchanged.
    running = !nonfinite && residualMax <= residualThreshold * (restart != 0 ? 1.0 : 0.5) ? 0u : 1u;
    if (running != 0u && (nonfinite || total.x <= 0.0 || rho <= 0.0)) {
        running = 0u;
        invalidInput = 1u;
        atomicAdd(pressureNonconverged, 1u);
        if (nonfinite) atomicAdd(nanInfDetected, 1u);
    }
    if (restart != 0) tileDispatch = uvec4(running != 0u ? tileInfo.x : 0u, 1u, 1u, 0u);
}
