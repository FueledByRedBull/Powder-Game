#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform usampler2D materialTex;
layout(binding = 1) uniform sampler2D sandOccupancyTex;
layout(r8ui, binding = 2) uniform writeonly uimage2D boundaryTex;
layout(r8ui, binding = 3) uniform writeonly uimage2D staticBoundaryTex;

uniform ivec2 gridSize;

// Sampled reads keep imageLoad's result outside the texture: zero.
vec4 loadTexel(sampler2D t, ivec2 c) {
    return all(lessThan(uvec2(c), uvec2(textureSize(t, 0)))) ? texelFetch(t, c, 0) : vec4(0.0);
}
uvec4 loadTexel(usampler2D t, ivec2 c) {
    return all(lessThan(uvec2(c), uvec2(textureSize(t, 0)))) ? texelFetch(t, c, 0) : uvec4(0u);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= gridSize.x || coord.y >= gridSize.y) {
        return;
    }

    uint material = loadTexel(materialTex, coord).r;
    float sand_occupancy = loadTexel(sandOccupancyTex, coord).x;
    // Painted rock (2) and wood (3, 256 and up while burning or charred; wood_burn.comp) are solids.
    bool solid = material >= 2u;
    uint static_blocked = solid ? 1u : 0u;
    // 1 is a painted solid. Sand walls off water above a quarter of rest density (a lone grain peaks at 0.28 and stays
    // open to the water around it; a poured pile is 0.3-1) and gas above three quarters, marked 2 and 3.
    uint blocked = solid ? 1u : (sand_occupancy > 0.75 ? 3u : (sand_occupancy > 0.25 ? 2u : 0u));
    imageStore(staticBoundaryTex, coord, uvec4(static_blocked, 0u, 0u, 0u));
    imageStore(boundaryTex, coord, uvec4(blocked, 0u, 0u, 0u));
}
