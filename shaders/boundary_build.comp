#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(r16ui, binding = 0) uniform readonly uimage2D materialTex;
layout(r16f, binding = 1) uniform readonly image2D sandOccupancyTex;
layout(r8ui, binding = 2) uniform writeonly uimage2D boundaryTex;
layout(r8ui, binding = 3) uniform writeonly uimage2D staticBoundaryTex;

uniform ivec2 gridSize;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= gridSize.x || coord.y >= gridSize.y) {
        return;
    }

    uint material = imageLoad(materialTex, coord).r;
    float sand_occupancy = imageLoad(sandOccupancyTex, coord).x;
    uint static_blocked = material == 2u ? 1u : 0u;
    uint blocked = material == 2u || sand_occupancy > 0.05 ? 1u : 0u;
    imageStore(staticBoundaryTex, coord, uvec4(static_blocked, 0u, 0u, 0u));
    imageStore(boundaryTex, coord, uvec4(blocked, 0u, 0u, 0u));
}
