#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D gasUTex;
layout(binding = 1) uniform sampler2D gasVTex;
layout(rg16f, binding = 2) uniform writeonly image2D gasCenterVelocityTex;
layout(binding = 3) uniform usampler2D boundaryTex;

uniform ivec2 gasSize;

// Sampled reads keep imageLoad's result outside the texture: zero.
vec4 loadTexel(sampler2D t, ivec2 c) {
    return all(lessThan(uvec2(c), uvec2(textureSize(t, 0)))) ? texelFetch(t, c, 0) : vec4(0.0);
}
uvec4 loadTexel(usampler2D t, ivec2 c) {
    return all(lessThan(uvec2(c), uvec2(textureSize(t, 0)))) ? texelFetch(t, c, 0) : uvec4(0u);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= gasSize.x || coord.y >= gasSize.y) {
        return;
    }
    if (loadTexel(boundaryTex, coord).r != 0u) {
        imageStore(gasCenterVelocityTex, coord, vec4(0.0));
        return;
    }

    float uL = loadTexel(gasUTex, ivec2(coord.x, coord.y)).x;
    float uR = loadTexel(gasUTex, ivec2(coord.x + 1, coord.y)).x;
    float vB = loadTexel(gasVTex, ivec2(coord.x, coord.y)).x;
    float vT = loadTexel(gasVTex, ivec2(coord.x, coord.y + 1)).x;
    imageStore(gasCenterVelocityTex, coord, vec4(0.5 * (uL + uR), 0.5 * (vB + vT), 0.0, 0.0));
}
