#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(r8ui, binding = 0) uniform readonly uimage2D boundaryTex;
layout(r16f, binding = 1) uniform readonly image2D sandOccupancyTex;
layout(rg16f, binding = 2) uniform readonly image2D sandVelocityTex;
layout(r16f, binding = 3) uniform readonly image2D waterAmountTex;
layout(rg16f, binding = 5) uniform readonly image2D combustionTex;
layout(r16f, binding = 6) uniform readonly image2D temperatureTex;
layout(rg16f, binding = 7) uniform readonly image2D gasVelTex;
layout(r16f, binding = 8) uniform readonly image2D smokeDenTex;
layout(r16f, binding = 9) uniform readonly image2D fuelTex;
layout(r16f, binding = 10) uniform readonly image2D oxidizerTex;
layout(r8ui, binding = 11) uniform writeonly uimage2D tileActiveTex;
layout(r8ui, binding = 12) uniform uimage2D tileSleepTex;

uniform ivec2 gridSize;
uniform ivec2 heatSize;
uniform ivec2 smokeSize;
uniform ivec2 tileSize;
uniform int sleepFrames;

bool inBounds(ivec2 coord, ivec2 size) {
    return coord.x >= 0 && coord.y >= 0 && coord.x < size.x && coord.y < size.y;
}

bool fullCellActive(ivec2 coord) {
    float sand_occupancy = imageLoad(sandOccupancyTex, coord).x;
    if (sand_occupancy > 0.05) {
        return true;
    }
    vec2 sand_velocity = imageLoad(sandVelocityTex, coord).xy;
    if (dot(sand_velocity, sand_velocity) > 0.0036) {
        return true;
    }
    // Even weak liquid tails change the persistent fields in the coupling equations.
    return imageLoad(waterAmountTex, coord).x > 0.0;
}

bool heatCellActive(ivec2 coord) {
    vec2 combustion = imageLoad(combustionTex, coord).xy;
    if (combustion.y > 0.01) {
        return true;
    }
    if (imageLoad(temperatureTex, coord).x > 0.012) {
        return true;
    }
    if (imageLoad(fuelTex, coord).x > 0.01) {
        return true;
    }
    vec2 gas_velocity = imageLoad(gasVelTex, coord).xy;
    return dot(gas_velocity, gas_velocity) > 0.00006;
}

bool smokeCellActive(ivec2 coord) {
    float density = imageLoad(smokeDenTex, coord).x;
    if (density > 0.01) {
        return true;
    }
    vec2 velocity = imageLoad(gasVelTex, coord).xy;
    return dot(velocity, velocity) > 0.0001;
}

void main() {
    ivec2 tile_coord = ivec2(gl_GlobalInvocationID.xy);
    if (!inBounds(tile_coord, tileSize)) {
        return;
    }

    ivec2 full_min = tile_coord * 16;
    ivec2 full_max = min(full_min + ivec2(16), gridSize);

    bool tile_is_active = false;

    for (int y = full_min.y; y < full_max.y && !tile_is_active; ++y) {
        for (int x = full_min.x; x < full_max.x; ++x) {
            if (fullCellActive(ivec2(x, y))) {
                tile_is_active = true;
                break;
            }
        }
    }

    if (!tile_is_active) {
        ivec2 heat_min = clamp(full_min / 2, ivec2(0), heatSize - ivec2(1));
        ivec2 heat_max = clamp((full_max - ivec2(1)) / 2, ivec2(0), heatSize - ivec2(1));
        for (int y = heat_min.y; y <= heat_max.y && !tile_is_active; ++y) {
            for (int x = heat_min.x; x <= heat_max.x; ++x) {
                if (heatCellActive(ivec2(x, y))) {
                    tile_is_active = true;
                    break;
                }
            }
        }
    }

    if (!tile_is_active) {
        ivec2 smoke_min = clamp(full_min / 2, ivec2(0), smokeSize - ivec2(1));
        ivec2 smoke_max = clamp((full_max - ivec2(1)) / 2, ivec2(0), smokeSize - ivec2(1));
        for (int y = smoke_min.y; y <= smoke_max.y && !tile_is_active; ++y) {
            for (int x = smoke_min.x; x <= smoke_max.x; ++x) {
                if (smokeCellActive(ivec2(x, y))) {
                    tile_is_active = true;
                    break;
                }
            }
        }
    }

    uint previous_sleep = imageLoad(tileSleepTex, tile_coord).r;
    uint next_sleep = tile_is_active ? 0u : min(previous_sleep + 1u, uint(max(sleepFrames, 1)));
    uint active_value = (tile_is_active || next_sleep < uint(max(sleepFrames, 1))) ? 1u : 0u;
    imageStore(tileSleepTex, tile_coord, uvec4(next_sleep, 0u, 0u, 0u));
    imageStore(tileActiveTex, tile_coord, uvec4(active_value, 0u, 0u, 0u));
}
