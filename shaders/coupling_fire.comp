#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform usampler2D boundaryTex;
layout(binding = 1) uniform sampler2D waterAmountTex;
layout(binding = 2) uniform sampler2D temperatureTex;
layout(rg16f, binding = 3) uniform image2D combustionTex;
layout(r16f, binding = 4) uniform image2D oxidizerTex;
layout(r16f, binding = 5) uniform image2D fuelTex;
layout(binding = 6) uniform sampler2D oilTex;            // x: oil share of the liquid (oil_field.comp)
layout(binding = 7) uniform sampler2D sandOccupancyTex;

uniform ivec2 gridSize;
uniform ivec2 heatSize;
uniform float dt;
uniform float waterCooling;
// Sand occupancy at which sand covering a cell smothers its fire completely (cuts fuel and oxygen like water does).
uniform float sandSmother;

// Sampled reads keep imageLoad's result outside the texture: zero.
vec4 loadTexel(sampler2D t, ivec2 c) {
    return all(lessThan(uvec2(c), uvec2(textureSize(t, 0)))) ? texelFetch(t, c, 0) : vec4(0.0);
}
uvec4 loadTexel(usampler2D t, ivec2 c) {
    return all(lessThan(uvec2(c), uvec2(textureSize(t, 0)))) ? texelFetch(t, c, 0) : uvec4(0u);
}

// Liquid that is water, not oil (oil is fuel, not a quencher), and sand, averaged over the gas cell's 2x2 cells.
float sampleWater(ivec2 gas_coord, out float sand) {
    ivec2 full = clamp(gas_coord * 2, ivec2(0), gridSize - ivec2(2));
    float water = 0.0;
    sand = 0.0;
    for (int i = 0; i < 4; ++i) {
        ivec2 cell = full + ivec2(i & 1, i >> 1);
        water += loadTexel(waterAmountTex, cell).x * (1.0 - loadTexel(oilTex, cell).x);
        sand += loadTexel(sandOccupancyTex, cell).x;
    }
    sand *= 0.25;
    return 0.25 * water;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(coord, heatSize))) {
        return;
    }

    float sand;
    float water = sampleWater(coord, sand);
    vec2 combustion = imageLoad(combustionTex, coord).xy;
    float oxidizer = imageLoad(oxidizerTex, coord).x;
    float fuel = imageLoad(fuelTex, coord).x;

    if (loadTexel(boundaryTex, coord).r != 0u) {
        imageStore(combustionTex, coord, vec4(0.0));
        imageStore(oxidizerTex, coord, vec4(0.0));
        imageStore(fuelTex, coord, vec4(0.0));
        return;
    }

    float suppression = max(clamp(water * waterCooling, 0.0, 1.0), clamp(sand / sandSmother, 0.0, 1.0));
    combustion.y *= pow(max(1.0 - suppression * 2.2, 0.0), dt * 60.0);
    fuel = clamp(fuel * pow(1.0 - suppression * 0.85, dt * 60.0), 0.0, 1.0);
    oxidizer = clamp(oxidizer * pow(max(1.0 - suppression * 1.2, 0.0), dt * 60.0), 0.0, 1.0);

    imageStore(combustionTex, coord, vec4(combustion, 0.0, 0.0));
    imageStore(fuelTex, coord, vec4(fuel, 0.0, 0.0, 0.0));
    imageStore(oxidizerTex, coord, vec4(oxidizer, 0.0, 0.0, 0.0));
}
