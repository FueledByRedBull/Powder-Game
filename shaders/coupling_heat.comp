#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(r16f, binding = 0) uniform image2D temperatureTex;
layout(r16f, binding = 1) uniform readonly image2D waterAmountTex;

uniform ivec2 heatSize;
uniform ivec2 gridSize;
uniform float dt;
uniform float waterCooling;

float waterSample(ivec2 full_coord) {
    ivec2 clamped = clamp(full_coord, ivec2(0), gridSize - ivec2(1));
    return imageLoad(waterAmountTex, clamped).x;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(coord, heatSize))) {
        return;
    }

    ivec2 full = coord * 2;

    float water_avg = 0.25 *
                      (waterSample(full) + waterSample(full + ivec2(1, 0)) + waterSample(full + ivec2(0, 1)) +
                       waterSample(full + ivec2(1, 1)));

    float heat = imageLoad(temperatureTex, coord).x;
    float wet = clamp(water_avg * waterCooling, 0.0, 1.0);
    heat = clamp(heat * pow(1.0 - wet, dt * 60.0), 0.0, 1.0);

    imageStore(temperatureTex, coord, vec4(heat, 0.0, 0.0, 0.0));
}
