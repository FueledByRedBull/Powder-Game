#version 430

// Wood, one gas cell (2x2 simulation cells) per invocation, so each invocation owns what it writes.
// Material values: 3 intact wood; 256 + f burning with f (0-255) fuel left; 512 + f charred and out (water put it
// out), which can catch again. Burning wood loses one unit per tick (about 4 s per cell) and then becomes empty;
// it renders darker as it burns (composite.frag).
// Mode 0 updates the wood: it catches when the open gas next to it is hot, with a per-tick chance so a fire creeps
// along a beam, and water on or next to a cell puts it out. Mode 1 feeds open gas cells next to burning wood with
// hot fuel vapour (max, not add), which the gas burns into flame, heat and smoke; that heat lights the next wood.
layout(local_size_x = 16, local_size_y = 16) in;

layout(r16ui, binding = 0) uniform uimage2D materialTex;
layout(r8ui, binding = 1) uniform readonly uimage2D gasMaskTex;
layout(r16f, binding = 2) uniform image2D temperatureTex;
layout(r16f, binding = 3) uniform image2D fuelTex;
layout(rg16f, binding = 4) uniform image2D reactionTex;
layout(r16f, binding = 5) uniform readonly image2D waterAmountTex;

// On a sample tick (tally 1), mode 0 adds the wood cells left after its update to woodCells (intact, burning or charred).
layout(std430, binding = 0) buffer WoodTally {
    uint woodCells;
};

uniform ivec2 gasSize;
uniform int mode;
uniform int tally;
uniform uint seed;
uniform float ignitionTemperature;
uniform float igniteChance;  // per tick while hot

bool isWood(uint material) {
    return material == 3u || material >= 256u;
}

bool burning(uint material) {
    return material >= 256u && material < 512u;
}

uint hash(uvec2 p, uint salt) {
    uint h = p.x * 0x8da6b343u ^ p.y * 0xd8163841u ^ salt * 0xcb1ab31fu;
    h ^= h >> 16;
    h *= 0x7feb352du;
    h ^= h >> 15;
    return h;
}

void main() {
    ivec2 gas = ivec2(gl_GlobalInvocationID.xy);
    if (gas.x >= gasSize.x || gas.y >= gasSize.y) {
        return;
    }
    if (mode == 0) {
        // Hottest open gas within two gas cells: the gas mask's one-cell halo closes the cells right next to wood.
        float heat = 0.0;
        for (int y = -2; y <= 2; ++y) {
            for (int x = -2; x <= 2; ++x) {
                ivec2 n = clamp(gas + ivec2(x, y), ivec2(0), gasSize - 1);
                if (imageLoad(gasMaskTex, n).r == 0u) heat = max(heat, imageLoad(temperatureTex, n).x);
            }
        }
        uint remaining = 0u;
        for (int i = 0; i < 4; ++i) {
            ivec2 cell = gas * 2 + ivec2(i & 1, i >> 1);
            uint material = imageLoad(materialTex, cell).r;
            if (!isWood(material)) continue;
            float wet = 0.0;
            for (int y = -1; y <= 1; ++y)
                for (int x = -1; x <= 1; ++x)
                    wet = max(wet, imageLoad(waterAmountTex, clamp(cell + ivec2(x, y), ivec2(0), gasSize * 2 - 1)).x);
            uint fuel = material == 3u ? 255u : (material & 255u);
            uint next = material;
            if (wet > 0.05) {
                if (burning(material)) next = 512u + fuel;
            } else if (burning(material)) {
                next = fuel == 0u ? 0u : material - 1u;
            } else if (heat >= ignitionTemperature &&
                       float(hash(uvec2(cell), seed) & 0xFFFFu) / 65535.0 < igniteChance) {
                next = 256u + fuel;
            }
            if (next != material) imageStore(materialTex, cell, uvec4(next));
            if (isWood(next)) ++remaining;
        }
        if (tally != 0 && remaining > 0u) atomicAdd(woodCells, remaining);
        return;
    }
    if (imageLoad(gasMaskTex, gas).r != 0u) {
        return;
    }
    // Burning wood cells among the 10x10 simulation cells around this open gas cell (past the mask halo).
    float count = 0.0;
    for (int y = -4; y < 6; ++y) {
        for (int x = -4; x < 6; ++x) {
            ivec2 cell = gas * 2 + ivec2(x, y);
            if (any(lessThan(cell, ivec2(0))) || any(greaterThanEqual(cell, gasSize * 2))) continue;
            if (burning(imageLoad(materialTex, cell).r)) count += 1.0;
        }
    }
    if (count == 0.0) {
        return;
    }
    float feed = min(count / 10.0, 1.0);
    imageStore(fuelTex, gas, vec4(max(imageLoad(fuelTex, gas).x, 0.45 * feed)));
    imageStore(temperatureTex, gas, vec4(max(imageLoad(temperatureTex, gas).x, 0.6 * feed)));
    vec2 reaction = imageLoad(reactionTex, gas).xy;
    imageStore(reactionTex, gas, vec4(reaction.x, max(reaction.y, 0.3 * feed), 0.0, 0.0));
}
