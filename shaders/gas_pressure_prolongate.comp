#version 430

// Adds the bilinear interpolation of the coarse correction to a fluid fine cell. A coarse donor that is a wall
// or outside the level is replaced by the fine cell's own parent (Neumann at walls); gas_pressure_restrict.comp
// applies exactly the transpose, which keeps the V-cycle symmetric for the conjugate gradient.
layout(local_size_x = 16, local_size_y = 16) in;

layout(r32f, binding = 0) uniform readonly image2D coarsePressureTex;
layout(r32f, binding = 1) uniform image2D finePressureTex;
layout(r8ui, binding = 2) uniform readonly uimage2D fineKindTex;
layout(r8ui, binding = 3) uniform readonly uimage2D coarseKindTex;

uniform ivec2 fineSize;
uniform ivec2 coarseSize;

bool coarseFluid(ivec2 coord) {
    return all(greaterThanEqual(coord, ivec2(0))) && all(lessThan(coord, coarseSize)) &&
           imageLoad(coarseKindTex, coord).r == 0u;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= fineSize.x || coord.y >= fineSize.y) {
        return;
    }
    if (imageLoad(fineKindTex, coord).r != 0u) {
        imageStore(finePressureTex, coord, vec4(0.0));
        return;
    }
    ivec2 parent = coord / 2;
    // Nearest coarse centres: the parent and its neighbours toward this child, weights 9/16, 3/16, 3/16, 1/16.
    ivec2 toward = ivec2(coord.x & 1, coord.y & 1) * 2 - 1;
    float value = imageLoad(finePressureTex, coord).x;
    for (int i = 0; i < 4; ++i) {
        ivec2 offset = ivec2(i & 1, i >> 1);
        ivec2 donor = parent + offset * toward;
        float weight = (offset.x == 0 ? 0.75 : 0.25) * (offset.y == 0 ? 0.75 : 0.25);
        value += weight * imageLoad(coarsePressureTex, coarseFluid(donor) ? donor : parent).x;
    }
    imageStore(finePressureTex, coord, vec4(value, 0.0, 0.0, 0.0));
}
