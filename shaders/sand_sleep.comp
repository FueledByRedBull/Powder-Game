#version 430

// Sleep tally: advances each grain's still-tick timer and counts the grains of every cell (sand_pack.comp decides).
layout(local_size_x = 256) in;

struct SandParticle {
    vec4 state0;
    vec4 state1;  // x: 0 inactive, else 1 + ticks the grain has been slower than sleepSpeed + hardening fraction
    vec4 state2;
    vec4 state3;
};

layout(std430, binding = 0) buffer SandParticles {
    SandParticle particles[];
};

// Per cell: bits 0-11 grains, 12-23 ready grains (sand_pack.comp adds bit 30 wake, bit 31 pack).
layout(std430, binding = 1) buffer SandCellTally {
    uint tally[];
};

// Per cell: sums of the ready grains' volume ratio J = det F, hardening fraction (state1.x's), moisture and bond
// exp(-q / cohesionSoftening) (the share of the capillary cohesion each grain still holds), times 4096.
layout(std430, binding = 2) buffer SandCellFSum {
    int fsum[];
};

uniform ivec2 gridSize;
uniform int maxParticles;
uniform float sleepSpeed;
uniform int sleepTicks;
// sand_particle_step.comp's cohesionSoftening: plastic strain over which a grain's liquid bridges decay by e.
uniform float cohesionSoftening;

bool invalid(vec2 value) {
    return any(isnan(value)) || any(isinf(value));
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uint(maxParticles)) {
        return;
    }
    SandParticle particle = particles[index];
    // NaN fails the comparison; sand_particle_compact.comp uses the same test to drop exactly these grains.
    if (!(particle.state1.x >= 0.5)) {
        return;
    }
    vec2 position = particle.state0.xy;
    if (invalid(position) || any(lessThan(position, vec2(0.0))) || any(greaterThanEqual(position, vec2(gridSize)))) {
        return;
    }
    float speed = length(particle.state0.zw);
    float still = speed < sleepSpeed ? min(floor(particle.state1.x - 1.0) + 1.0, 255.0) : 0.0;
    // The fraction is the grain's friction hardening (sand_particle_step.comp).
    particles[index].state1.x = 1.0 + still + fract(particle.state1.x);

    mat2 deformation = mat2(particle.state3.xy, particle.state3.zw);
    float volume = determinant(deformation);
    // Damp grains pack too: packed cells keep their mean hardening and moisture, hold the moving grains beside them by
    // those capillary bonds (sand_grid_update.comp) and restore them on wake.
    bool ready = still >= float(sleepTicks) && particle.state1.y == 1.0 && volume > 0.0 && volume < 64.0;
    ivec2 cell = ivec2(floor(position));
    int cellIndex = cell.y * gridSize.x + cell.x;
    atomicAdd(tally[cellIndex], ready ? 4097u : 1u);
    if (ready) {
        // Woken grains restart isotropic at the mean J (sand_pack.comp), so J is all of F a packed cell keeps; the
        // hardening and moisture fractions come back with them (sand_particle_step.comp's record layout). The bond
        // (the mean of exp(-q / softening), not the exponential of the mean q) tells a mixed cell's intact grains from
        // its cracked ones.
        float hardened = fract(particle.state1.x);
        float bond = exp(-4.0 * hardened / max(1.0 - hardened, 1e-4) / cohesionSoftening);
        vec4 kept = vec4(volume, hardened, particle.state2.w - floor(particle.state2.w), bond);
        for (int k = 0; k < 4; ++k) {
            atomicAdd(fsum[4 * cellIndex + k], int(round(kept[k] * 4096.0)));
        }
    }
}
