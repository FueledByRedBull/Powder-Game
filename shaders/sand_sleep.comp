#version 430

// Sleep tally: advances each grain's still-tick timer and counts the grains of every cell (sand_pack.comp decides).
layout(local_size_x = 256) in;

struct SandParticle {
    vec4 state0;
    vec4 state1;  // x: 0 inactive, else 1 + ticks the grain has been slower than sleepSpeed
    vec4 state2;
    vec4 state3;
};

layout(std430, binding = 0) buffer SandParticles {
    SandParticle particles[];
};

// Per cell: bits 0-11 grains, 12-23 ready grains (sand_pack.comp adds bit 30 wake, bit 31 pack).
layout(std430, binding = 1) buffer SandCellTally {
    uint tally[];
};

// Per cell: sums of the ready grains' left stretch V = F R^T (column-major, moisture in place of the symmetric [1][0]),
// times 4096.
layout(std430, binding = 2) buffer SandCellFSum {
    int fsum[];
};

uniform ivec2 gridSize;
uniform int maxParticles;
uniform float sleepSpeed;
uniform int sleepTicks;

bool invalid(vec2 value) {
    return any(isnan(value)) || any(isinf(value));
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uint(maxParticles)) {
        return;
    }
    SandParticle particle = particles[index];
    // NaN fails the comparison; sand_particle_compact.comp uses the same test to drop exactly these grains.
    if (!(particle.state1.x >= 0.5)) {
        return;
    }
    vec2 position = particle.state0.xy;
    if (invalid(position) || any(lessThan(position, vec2(0.0))) || any(greaterThanEqual(position, vec2(gridSize)))) {
        return;
    }
    float speed = length(particle.state0.zw);
    float still = speed < sleepSpeed ? min(floor(particle.state1.x - 1.0) + 1.0, 255.0) : 0.0;
    particles[index].state1.x = 1.0 + still;

    mat2 deformation = mat2(particle.state3.xy, particle.state3.zw);
    float volume = determinant(deformation);
    bool ready = still >= float(sleepTicks) && particle.state1.y == 1.0 && volume > 0.0 && volume < 64.0;
    ivec2 cell = ivec2(floor(position));
    int cellIndex = cell.y * gridSize.x + cell.x;
    atomicAdd(tally[cellIndex], ready ? 4097u : 1u);
    if (ready) {
        // The left stretch V = F R^T: averaging whole F would average the grains' rotations too, shrinking the mean
        // (det of a mean rotation < 1) into a spurious compression. V keeps the stress the grain holds.
        vec2 rotation = normalize(vec2(deformation[0][0] + deformation[1][1], deformation[0][1] - deformation[1][0]));
        mat2 stretch = deformation * transpose(mat2(rotation, vec2(-rotation.y, rotation.x)));
        // V is symmetric, so its [1][0] slot carries the grain's moisture (sand_particle_step.comp's state2.w fraction).
        vec4 packedStretch = vec4(stretch[0], particle.state2.w - floor(particle.state2.w), stretch[1][1]);
        for (int k = 0; k < 4; ++k) {
            atomicAdd(fsum[4 * cellIndex + k], int(round(packedStretch[k] * 4096.0)));
        }
    }
}
