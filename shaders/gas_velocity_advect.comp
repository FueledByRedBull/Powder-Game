#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(r16f, binding = 0) uniform readonly image2D gasUSrc;
layout(r16f, binding = 1) uniform readonly image2D gasVSrc;
layout(rg16f, binding = 2) uniform readonly image2D gasCenterVelocityTex;
layout(r16f, binding = 3) uniform writeonly image2D gasUDst;
layout(r16f, binding = 4) uniform writeonly image2D gasVDst;
layout(r8ui, binding = 5) uniform readonly uimage2D boundaryTex;

uniform ivec2 gasSize;
uniform float dt;
uniform float maxVelocity;

ivec2 clampCell(ivec2 coord) {
    return clamp(coord, ivec2(0), gasSize - ivec2(1));
}

bool blockedCell(ivec2 coord) {
    return coord.x < 0 || coord.y < 0 || coord.x >= gasSize.x || coord.y >= gasSize.y || imageLoad(boundaryTex, coord).r != 0u;
}


struct TransportStencil {
    ivec2 cells[4];
    vec4 weights;
};

// Traverse crossed cells, stopping before a solid face or a sealed diagonal corner.
vec2 clipTrace(vec2 start, vec2 end) {
    vec2 delta = end - start;
    ivec2 cell = ivec2(floor(start));
    ivec2 direction = ivec2(sign(delta));
    vec2 interval = 1.0 / max(abs(delta), vec2(1e-20));
    vec2 nextEdge = vec2(delta.x >= 0.0 ? float(cell.x + 1) - start.x : start.x - float(cell.x),
                         delta.y >= 0.0 ? float(cell.y + 1) - start.y : start.y - float(cell.y)) * interval;
    for (int crossing = 0; crossing < gasSize.x + gasSize.y + 2; ++crossing) {
        float t = min(nextEdge.x, nextEdge.y);
        if (t > 1.0) return end;
        bool crossX = nextEdge.x <= nextEdge.y;
        bool crossY = nextEdge.y <= nextEdge.x;
        ivec2 nextCell = cell + ivec2(crossX ? direction.x : 0, crossY ? direction.y : 0);
        if ((crossX && blockedCell(cell + ivec2(direction.x, 0))) ||
            (crossY && blockedCell(cell + ivec2(0, direction.y))) || blockedCell(nextCell)) {
            float margin = 0.001 / max(max(abs(delta.x), abs(delta.y)), 1.0);
            return start + delta * max(0.0, t - margin);
        }
        cell = nextCell;
        nextEdge += vec2(crossX ? interval.x : 0.0, crossY ? interval.y : 0.0);
    }
    return start;
}

bool donorOpen(ivec2 cell, int component) {
    if (blockedCell(cell)) return false;
    if (component == 0) return !blockedCell(cell - ivec2(1, 0));
    if (component == 1) return !blockedCell(cell - ivec2(0, 1));
    return true;
}

TransportStencil transportStencil(vec2 start, vec2 end, vec2 offset, ivec2 maximum, int component) {
    vec2 point = clipTrace(start, end);
    vec2 samplePoint = clamp(point - offset, vec2(0.0), vec2(maximum));
    ivec2 base = ivec2(floor(samplePoint));
    vec2 fraction = fract(samplePoint);
    TransportStencil stencil;
    stencil.weights = vec4((1.0 - fraction.x) * (1.0 - fraction.y), fraction.x * (1.0 - fraction.y),
                           (1.0 - fraction.x) * fraction.y, fraction.x * fraction.y);
    for (int i = 0; i < 4; ++i) {
        stencil.cells[i] = clamp(base + ivec2(i & 1, i >> 1), ivec2(0), maximum);
        vec2 donor = vec2(stencil.cells[i]) + offset;
        if (stencil.weights[i] > 0.0 &&
            (!donorOpen(stencil.cells[i], component) || any(notEqual(clipTrace(point, donor), donor)))) {
            stencil.weights[i] = 0.0;
        }
    }
    float total = dot(stencil.weights, vec4(1.0));
    if (total > 0.0) {
        stencil.weights /= total;
    } else {
        // A clipped characteristic with no admissible donor retains its local source value.
        for (int i = 0; i < 4; ++i) stencil.cells[i] = clamp(ivec2(start - offset), ivec2(0), maximum);
        stencil.weights = vec4(1.0, 0.0, 0.0, 0.0);
    }
    return stencil;
}

vec2 sampleCenterVelocity(vec2 position) {
    vec2 p = clamp(position - vec2(0.5), vec2(0.0), vec2(gasSize) - vec2(1.0));
    ivec2 base = ivec2(floor(p));
    vec2 frac = fract(p);
    vec2 v00 = imageLoad(gasCenterVelocityTex, base).xy;
    vec2 v10 = imageLoad(gasCenterVelocityTex, clampCell(base + ivec2(1, 0))).xy;
    vec2 v01 = imageLoad(gasCenterVelocityTex, clampCell(base + ivec2(0, 1))).xy;
    vec2 v11 = imageLoad(gasCenterVelocityTex, clampCell(base + ivec2(1, 1))).xy;
    return clamp(mix(mix(v00, v10, frac.x), mix(v01, v11, frac.x), frac.y), vec2(-maxVelocity), vec2(maxVelocity));
}

float sampleU(TransportStencil stencil) {
    vec4 values;
    for (int i = 0; i < 4; ++i) values[i] = imageLoad(gasUSrc, stencil.cells[i]).x;
    return dot(stencil.weights, values);
}

float sampleV(TransportStencil stencil) {
    vec4 values;
    for (int i = 0; i < 4; ++i) values[i] = imageLoad(gasVSrc, stencil.cells[i]).x;
    return dot(stencil.weights, values);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);

    if (coord.x <= gasSize.x && coord.y < gasSize.y) {
        float value = 0.0;
        if (coord.x > 0 && coord.x < gasSize.x && !blockedCell(ivec2(coord.x - 1, coord.y)) &&
            !blockedCell(ivec2(coord.x, coord.y))) {
            vec2 facePos = vec2(float(coord.x), float(coord.y) + 0.5);
            vec2 backtrace = clamp(facePos - sampleCenterVelocity(facePos) * dt, vec2(0.0, 0.5), vec2(gasSize.x, gasSize.y - 0.5));
            TransportStencil stencil = transportStencil(facePos, backtrace, vec2(0.0, 0.5), ivec2(gasSize.x, gasSize.y - 1), 0);
            value = sampleU(stencil);
        }
        imageStore(gasUDst, coord, vec4(value, 0.0, 0.0, 0.0));
    }

    if (coord.x < gasSize.x && coord.y <= gasSize.y) {
        float value = 0.0;
        if (coord.y > 0 && coord.y < gasSize.y && !blockedCell(ivec2(coord.x, coord.y - 1)) &&
            !blockedCell(ivec2(coord.x, coord.y))) {
            vec2 facePos = vec2(float(coord.x) + 0.5, float(coord.y));
            vec2 backtrace = clamp(facePos - sampleCenterVelocity(facePos) * dt, vec2(0.5, 0.0), vec2(gasSize.x - 0.5, gasSize.y));
            TransportStencil stencil = transportStencil(facePos, backtrace, vec2(0.5, 0.0), ivec2(gasSize.x - 1, gasSize.y), 1);
            value = sampleV(stencil);
        }
        imageStore(gasVDst, coord, vec4(value, 0.0, 0.0, 0.0));
    }
}
