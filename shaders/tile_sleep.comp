#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(r8ui, binding = 0) uniform readonly uimage2D rawActiveTex;
layout(r8ui, binding = 1) uniform writeonly uimage2D activeDstTex;
layout(r8ui, binding = 2) uniform uimage2D sleepTex;

layout(std430, binding = 0) buffer DebugCounters {
    uint nanInfDetected;
    uint particleOverflowBlocked;
    uint pressureNonconverged;
    uint inactiveTileMisses;
};

uniform ivec2 tileSize;
uniform int sleepFrames;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= tileSize.x || coord.y >= tileSize.y) {
        return;
    }

    uint rawActive = imageLoad(rawActiveTex, coord).r != 0u ? 1u : 0u;
    uint previousSleep = imageLoad(sleepTex, coord).r;
    uint sleepLimit = uint(max(sleepFrames, 1));
    uint nextSleep = rawActive != 0u ? 0u : min(previousSleep + 1u, sleepLimit);
    uint activeValue = (rawActive != 0u || nextSleep < sleepLimit) ? 1u : 0u;
    imageStore(sleepTex, coord, uvec4(nextSleep, 0u, 0u, 0u));
    imageStore(activeDstTex, coord, uvec4(activeValue, 0u, 0u, 0u));
}
