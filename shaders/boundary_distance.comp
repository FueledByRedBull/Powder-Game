#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform usampler2D boundaryMaskTex;
layout(binding = 1) uniform isampler2D boundarySeedTex;
layout(r16f, binding = 2) uniform writeonly image2D boundarySdfTex;

uniform ivec2 gridSize;
uniform float maxDistance;

// Sampled reads keep imageLoad's result outside the texture: zero.
uvec4 loadTexel(usampler2D t, ivec2 c) {
    return all(lessThan(uvec2(c), uvec2(textureSize(t, 0)))) ? texelFetch(t, c, 0) : uvec4(0u);
}
ivec4 loadTexel(isampler2D t, ivec2 c) {
    return all(lessThan(uvec2(c), uvec2(textureSize(t, 0)))) ? texelFetch(t, c, 0) : ivec4(0);
}

bool inBounds(ivec2 coord) {
    return coord.x >= 0 && coord.y >= 0 && coord.x < gridSize.x && coord.y < gridSize.y;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (!inBounds(coord)) {
        return;
    }

    bool inside = loadTexel(boundaryMaskTex, coord).r != 0u;
    ivec2 seed = loadTexel(boundarySeedTex, coord).xy;
    float distance = maxDistance;
    if (seed.x >= 0 && seed.y >= 0) {
        // Interface seeds are cell centers on both sides; a half-cell offset preserves their signs.
        distance = length(vec2(coord - seed)) + 0.5;
    }

    float signed_distance = inside ? -distance : distance;
    imageStore(boundarySdfTex, coord, vec4(signed_distance, 0.0, 0.0, 0.0));
}
