#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D gasUSrc;
layout(binding = 1) uniform sampler2D gasVSrc;
layout(binding = 2) uniform sampler2D gasCenterVelocitySrc;
layout(binding = 3) uniform sampler2D gasUFwd;
layout(binding = 4) uniform sampler2D gasVFwd;
layout(binding = 5) uniform sampler2D gasCenterVelocityFwd;
layout(binding = 6) uniform sampler2D smokeDensityTex;
layout(binding = 7) uniform sampler2D temperatureTex;
layout(r32f, binding = 0) uniform writeonly image2D gasUDst;
layout(r32f, binding = 1) uniform writeonly image2D gasVDst;
layout(binding = 10) uniform usampler2D boundaryTex;

layout(std430, binding = 7) buffer DebugCounters {
    uint nanInfDetected;
    uint particleOverflowBlocked;
    uint pressureNonconverged;
    uint inactiveTileMisses;
};

uniform ivec2 gasSize;
uniform float dt;
uniform float velocityDissipation;
uniform float buoyancyTemperature;
uniform float buoyancySmoke;
uniform float maxVelocity;
// Vorticity confinement strength (1/s): puts back the small swirls that interpolation smooths away.
uniform float vorticity;

// Sampled reads keep imageLoad's result outside the texture: zero.
vec4 loadTexel(sampler2D t, ivec2 c) {
    return all(lessThan(uvec2(c), uvec2(textureSize(t, 0)))) ? texelFetch(t, c, 0) : vec4(0.0);
}
uvec4 loadTexel(usampler2D t, ivec2 c) {
    return all(lessThan(uvec2(c), uvec2(textureSize(t, 0)))) ? texelFetch(t, c, 0) : uvec4(0u);
}

ivec2 clampCell(ivec2 coord) {
    return clamp(coord, ivec2(0), gasSize - ivec2(1));
}

bool blockedCell(ivec2 coord) {
    return coord.x < 0 || coord.y < 0 || coord.x >= gasSize.x || coord.y >= gasSize.y || loadTexel(boundaryTex, coord).r != 0u;
}


struct TransportStencil {
    ivec2 cells[4];
    vec4 weights;
};

// Traverse crossed cells, stopping before a solid face or a sealed diagonal corner.
vec2 clipTrace(vec2 start, vec2 end) {
    vec2 delta = end - start;
    ivec2 cell = ivec2(floor(start));
    ivec2 direction = ivec2(sign(delta));
    vec2 interval = 1.0 / max(abs(delta), vec2(1e-20));
    vec2 nextEdge = vec2(delta.x >= 0.0 ? float(cell.x + 1) - start.x : start.x - float(cell.x),
                         delta.y >= 0.0 ? float(cell.y + 1) - start.y : start.y - float(cell.y)) * interval;
    for (int crossing = 0; crossing < gasSize.x + gasSize.y + 2; ++crossing) {
        float t = min(nextEdge.x, nextEdge.y);
        if (t > 1.0) return end;
        bool crossX = nextEdge.x <= nextEdge.y;
        bool crossY = nextEdge.y <= nextEdge.x;
        ivec2 nextCell = cell + ivec2(crossX ? direction.x : 0, crossY ? direction.y : 0);
        if ((crossX && blockedCell(cell + ivec2(direction.x, 0))) ||
            (crossY && blockedCell(cell + ivec2(0, direction.y))) || blockedCell(nextCell)) {
            float margin = 0.001 / max(max(abs(delta.x), abs(delta.y)), 1.0);
            return start + delta * max(0.0, t - margin);
        }
        cell = nextCell;
        nextEdge += vec2(crossX ? interval.x : 0.0, crossY ? interval.y : 0.0);
    }
    return start;
}

bool donorOpen(ivec2 cell, int component) {
    if (blockedCell(cell)) return false;
    if (component == 0) return !blockedCell(cell - ivec2(1, 0));
    if (component == 1) return !blockedCell(cell - ivec2(0, 1));
    return true;
}

TransportStencil transportStencil(vec2 start, vec2 end, vec2 offset, ivec2 maximum, int component) {
    vec2 point = clipTrace(start, end);
    vec2 samplePoint = clamp(point - offset, vec2(0.0), vec2(maximum));
    ivec2 base = ivec2(floor(samplePoint));
    vec2 fraction = fract(samplePoint);
    TransportStencil stencil;
    stencil.weights = vec4((1.0 - fraction.x) * (1.0 - fraction.y), fraction.x * (1.0 - fraction.y),
                           (1.0 - fraction.x) * fraction.y, fraction.x * fraction.y);
    for (int i = 0; i < 4; ++i) {
        stencil.cells[i] = clamp(base + ivec2(i & 1, i >> 1), ivec2(0), maximum);
        vec2 donor = vec2(stencil.cells[i]) + offset;
        if (stencil.weights[i] > 0.0 &&
            (!donorOpen(stencil.cells[i], component) || any(notEqual(clipTrace(point, donor), donor)))) {
            stencil.weights[i] = 0.0;
        }
    }
    float total = dot(stencil.weights, vec4(1.0));
    if (total > 0.0) {
        stencil.weights /= total;
    } else {
        // A clipped characteristic with no admissible donor retains its local source value.
        for (int i = 0; i < 4; ++i) stencil.cells[i] = clamp(ivec2(start - offset), ivec2(0), maximum);
        stencil.weights = vec4(1.0, 0.0, 0.0, 0.0);
    }
    return stencil;
}

vec2 sampleCenterVelocitySrc(vec2 position) {
    vec2 p = clamp(position - vec2(0.5), vec2(0.0), vec2(gasSize) - vec2(1.0));
    ivec2 base = ivec2(floor(p));
    vec2 frac = fract(p);
    vec2 v00 = loadTexel(gasCenterVelocitySrc, base).xy;
    vec2 v10 = loadTexel(gasCenterVelocitySrc, clampCell(base + ivec2(1, 0))).xy;
    vec2 v01 = loadTexel(gasCenterVelocitySrc, clampCell(base + ivec2(0, 1))).xy;
    vec2 v11 = loadTexel(gasCenterVelocitySrc, clampCell(base + ivec2(1, 1))).xy;
    return clamp(mix(mix(v00, v10, frac.x), mix(v01, v11, frac.x), frac.y), vec2(-maxVelocity), vec2(maxVelocity));
}




float sampleUFwd(TransportStencil stencil) {
    vec4 values;
    for (int i = 0; i < 4; ++i) values[i] = loadTexel(gasUFwd, stencil.cells[i]).x;
    return dot(stencil.weights, values);
}



float sampleVFwd(TransportStencil stencil) {
    vec4 values;
    for (int i = 0; i < 4; ++i) values[i] = loadTexel(gasVFwd, stencil.cells[i]).x;
    return dot(stencil.weights, values);
}

float clampLocalU(TransportStencil stencil, float value) {
    float minV = float(1e30), maxV = float(-1e30);
    for (int i = 0; i < 4; ++i) {
        if (stencil.weights[i] > 0.0) {
            float donor = loadTexel(gasUSrc, stencil.cells[i]).x;
            minV = min(minV, donor);
            maxV = max(maxV, donor);
        }
    }
    return clamp(value, minV, maxV);
}

float clampLocalV(TransportStencil stencil, float value) {
    float minV = float(1e30), maxV = float(-1e30);
    for (int i = 0; i < 4; ++i) {
        if (stencil.weights[i] > 0.0) {
            float donor = loadTexel(gasVSrc, stencil.cells[i]).x;
            minV = min(minV, donor);
            maxV = max(maxV, donor);
        }
    }
    return clamp(value, minV, maxV);
}

float sampleTemperature(ivec2 coord) {
    return loadTexel(temperatureTex, clampCell(coord)).x;
}

float sampleSmoke(ivec2 coord) {
    return loadTexel(smokeDensityTex, clampCell(coord)).x;
}

// Curl of the centred velocity at a cell; walls and the domain edge contribute none.
float curlAt(ivec2 c) {
    if (blockedCell(c)) return 0.0;
    vec2 l = loadTexel(gasCenterVelocitySrc, clampCell(c - ivec2(1, 0))).xy;
    vec2 r = loadTexel(gasCenterVelocitySrc, clampCell(c + ivec2(1, 0))).xy;
    vec2 b = loadTexel(gasCenterVelocitySrc, clampCell(c - ivec2(0, 1))).xy;
    vec2 t = loadTexel(gasCenterVelocitySrc, clampCell(c + ivec2(0, 1))).xy;
    return 0.5 * ((r.y - l.y) - (t.x - b.x));
}

// Fedkiw et al. 2001: f = epsilon (N x omega), N the unit gradient of |omega|.
vec2 confinementAt(ivec2 c) {
    if (vorticity <= 0.0 || blockedCell(c)) return vec2(0.0);
    vec2 gradient = 0.5 * vec2(abs(curlAt(c + ivec2(1, 0))) - abs(curlAt(c - ivec2(1, 0))),
                               abs(curlAt(c + ivec2(0, 1))) - abs(curlAt(c - ivec2(0, 1))));
    float len = length(gradient);
    if (len < 1e-4) return vec2(0.0);
    vec2 n = gradient / len;
    return vorticity * curlAt(c) * vec2(n.y, -n.x);
}

bool invalid(float value) {
    return isnan(value) || isinf(value);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);

    if (coord.x <= gasSize.x && coord.y < gasSize.y) {
        float value = 0.0;
        if (coord.x > 0 && coord.x < gasSize.x && !blockedCell(ivec2(coord.x - 1, coord.y)) &&
            !blockedCell(ivec2(coord.x, coord.y))) {
            vec2 facePos = vec2(float(coord.x), float(coord.y) + 0.5);
            vec2 backtrace = clamp(facePos - sampleCenterVelocitySrc(facePos) * dt,
                                   vec2(0.0, 0.5),
                                   vec2(gasSize.x, gasSize.y - 0.5));
            vec2 reverseTrace = clamp(facePos + sampleCenterVelocitySrc(facePos) * dt,
                                      vec2(0.0, 0.5),
                                      vec2(gasSize.x, gasSize.y - 0.5));
            TransportStencil backStencil = transportStencil(facePos, backtrace, vec2(0.0, 0.5), ivec2(gasSize.x, gasSize.y - 1), 0);
            TransportStencil reverseStencil = transportStencil(facePos, reverseTrace, vec2(0.0, 0.5), ivec2(gasSize.x, gasSize.y - 1), 0);
            value = loadTexel(gasUFwd, coord).x + 0.5 * (loadTexel(gasUSrc, coord).x - sampleUFwd(reverseStencil));
            value = clampLocalU(backStencil, value) * velocityDissipation;
            value += 0.5 * (confinementAt(ivec2(coord.x - 1, coord.y)).x + confinementAt(coord).x) * dt;
            value = clamp(value, -maxVelocity, maxVelocity);
            if (invalid(value)) {
                atomicAdd(nanInfDetected, 1u);
                value = 0.0;
            }
        }
        imageStore(gasUDst, coord, vec4(value, 0.0, 0.0, 0.0));
    }

    if (coord.x < gasSize.x && coord.y <= gasSize.y) {
        float value = 0.0;
        if (coord.y > 0 && coord.y < gasSize.y && !blockedCell(ivec2(coord.x, coord.y - 1)) &&
            !blockedCell(ivec2(coord.x, coord.y))) {
            vec2 facePos = vec2(float(coord.x) + 0.5, float(coord.y));
            vec2 backtrace = clamp(facePos - sampleCenterVelocitySrc(facePos) * dt,
                                   vec2(0.5, 0.0),
                                   vec2(gasSize.x - 0.5, gasSize.y));
            vec2 reverseTrace = clamp(facePos + sampleCenterVelocitySrc(facePos) * dt,
                                      vec2(0.5, 0.0),
                                      vec2(gasSize.x - 0.5, gasSize.y));
            TransportStencil backStencil = transportStencil(facePos, backtrace, vec2(0.5, 0.0), ivec2(gasSize.x - 1, gasSize.y), 1);
            TransportStencil reverseStencil = transportStencil(facePos, reverseTrace, vec2(0.5, 0.0), ivec2(gasSize.x - 1, gasSize.y), 1);
            value = loadTexel(gasVFwd, coord).x + 0.5 * (loadTexel(gasVSrc, coord).x - sampleVFwd(reverseStencil));
            value = clampLocalV(backStencil, value) * velocityDissipation;

            float temperature =
                0.5 * (sampleTemperature(ivec2(coord.x, coord.y - 1)) + sampleTemperature(ivec2(coord.x, coord.y)));
            float smoke = 0.5 * (sampleSmoke(ivec2(coord.x, coord.y - 1)) + sampleSmoke(ivec2(coord.x, coord.y)));
            value += (buoyancyTemperature * temperature - buoyancySmoke * smoke +
                      0.5 * (confinementAt(ivec2(coord.x, coord.y - 1)).y + confinementAt(coord).y)) * dt;
            value = clamp(value, -maxVelocity, maxVelocity);
            if (invalid(value)) {
                atomicAdd(nanInfDetected, 1u);
                value = 0.0;
            }
        }
        imageStore(gasVDst, coord, vec4(value, 0.0, 0.0, 0.0));
    }
}
