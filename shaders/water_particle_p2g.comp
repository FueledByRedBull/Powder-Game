#version 430

layout(local_size_x = 256) in;

layout(r8ui, binding = 0) uniform readonly uimage2D boundaryTex;

struct WaterParticle {
    vec4 state0;
    vec4 state1;
    vec4 state2;
};

layout(std430, binding = 0) readonly buffer WaterParticles {
    WaterParticle particles[];
};

layout(std430, binding = 1) buffer UFaceWeights {
    // shortcut: unit-mass capacity fits 32-bit weights; widen for heavier loads.
    uint uWeights[];
};

layout(std430, binding = 2) buffer VFaceWeights {
    uint vWeights[];
};

layout(std430, binding = 3) buffer UFaceVelocitySums {
    ivec2 uVelocitySums[];
};

layout(std430, binding = 4) buffer VFaceVelocitySums {
    ivec2 vVelocitySums[];
};

layout(std430, binding = 5) buffer WaterCellCounts {
    uint cellCounts[];
};

layout(std430, binding = 7) buffer DebugCounters {
    uint nanInfDetected;
    uint particleOverflowBlocked;
    uint pressureNonconverged;
    uint inactiveTileMisses;
};

uniform ivec2 gridSize;
uniform int maxParticles;
uniform float velocityScale;
uniform float weightScale;

bool cellInBounds(ivec2 coord) {
    return coord.x >= 0 && coord.y >= 0 && coord.x < gridSize.x && coord.y < gridSize.y;
}

bool blockedCell(ivec2 coord) {
    return !cellInBounds(coord) || imageLoad(boundaryTex, coord).r != 0u;
}

void quadraticWeights(float x, out vec3 w) {
    float d0 = 1.5 - x;
    float d1 = x - 1.0;
    float d2 = x - 0.5;
    w.x = 0.5 * d0 * d0;
    w.y = 0.75 - d1 * d1;
    w.z = 0.5 * d2 * d2;
}

bool invalidFloat(float value) {
    return isnan(value) || isinf(value);
}

bool invalidVec2(vec2 value) {
    return invalidFloat(value.x) || invalidFloat(value.y);
}

bool invalidMat2(mat2 value) {
    return invalidVec2(value[0]) || invalidVec2(value[1]);
}

int uFaceIndex(ivec2 face) {
    return face.y * (gridSize.x + 1) + face.x;
}

int vFaceIndex(ivec2 face) {
    return face.y * gridSize.x + face.x;
}

int cellIndex(ivec2 cell) {
    return cell.y * gridSize.x + cell.x;
}

// The low word wraps in GLSL; a signed wrap count keeps dense momentum exact.
int signedCarry(int previous, int delta) {
    if (delta > 0 && previous > 2147483647 - delta) return 1;
    if (delta < 0 && previous < (-2147483647 - 1) - delta) return -1;
    return 0;
}

// Compaction sorts the records by bin, so a workgroup's particles usually sit in a small box. Such a workgroup sums its
// deposits in shared memory and then adds each touched cell and face to the grid once. The sums are integers, so the
// result is bit-identical to depositing every particle directly, which a workgroup spread wider than the box still does.
// Every cell and face a particle in cell c touches lies in [c - 1, c + 2] on each axis.
const int kTile = 24;
const int kTileCells = kTile * kTile;
shared uint tileCells[kTileCells];
shared uint tileUWeights[kTileCells];
shared uint tileVWeights[kTileCells];
shared ivec2 tileUSums[kTileCells];
shared ivec2 tileVSums[kTileCells];
shared ivec2 tileMin;
shared ivec2 tileMax;
bool useTile = false;
ivec2 tileOrigin = ivec2(0);

int tileIndex(ivec2 coord) {
    ivec2 local = coord - tileOrigin;
    return local.y * kTile + local.x;
}

// kind 0: cell count, 1: u-face weight, 2: v-face weight.
void addCount(uint count, int globalIndex, ivec2 coord, int kind) {
    uint previous;
    if (useTile) {
        int t = tileIndex(coord);
        if (kind == 0) previous = atomicAdd(tileCells[t], count);
        else if (kind == 1) previous = atomicAdd(tileUWeights[t], count);
        else previous = atomicAdd(tileVWeights[t], count);
    } else {
        if (kind == 0) previous = atomicAdd(cellCounts[globalIndex], count);
        else if (kind == 1) previous = atomicAdd(uWeights[globalIndex], count);
        else previous = atomicAdd(vWeights[globalIndex], count);
    }
    if (previous > 0xffffffffu - count) atomicAdd(particleOverflowBlocked, 1u);
}

void addMomentum(int delta, int globalIndex, ivec2 coord, bool uFace) {
    if (useTile) {
        int t = tileIndex(coord);
        if (uFace) {
            int carry = signedCarry(atomicAdd(tileUSums[t].x, delta), delta);
            if (carry != 0) atomicAdd(tileUSums[t].y, carry);
        } else {
            int carry = signedCarry(atomicAdd(tileVSums[t].x, delta), delta);
            if (carry != 0) atomicAdd(tileVSums[t].y, carry);
        }
    } else if (uFace) {
        int carry = signedCarry(atomicAdd(uVelocitySums[globalIndex].x, delta), delta);
        if (carry != 0) atomicAdd(uVelocitySums[globalIndex].y, carry);
    } else {
        int carry = signedCarry(atomicAdd(vVelocitySums[globalIndex].x, delta), delta);
        if (carry != 0) atomicAdd(vVelocitySums[globalIndex].y, carry);
    }
}

void depositCell(ivec2 cell, float weight) {
    if (weight <= 0.0) {
        return;
    }
    addCount(uint(round(weight * weightScale)), cellIndex(cell), cell, 0);
}

void depositU(ivec2 face, float weight, float value) {
    if (weight <= 0.0) {
        return;
    }
    if (face.x < 0 || face.x > gridSize.x || face.y < 0 || face.y >= gridSize.y) {
        return;
    }
    ivec2 leftCell = ivec2(face.x - 1, face.y);
    ivec2 rightCell = ivec2(face.x, face.y);
    if (face.x == 0 || face.x == gridSize.x || blockedCell(leftCell) || blockedCell(rightCell)) {
        return;
    }

    int index = uFaceIndex(face);
    uint count = uint(round(weight * weightScale));
    addCount(count, index, face, 1);
    // Momentum uses the quantized weight, so a face average stays a convex mix of particle velocities even where
    // edge-of-support weights round to zero (a rounded-away weight with full momentum amplified sparse faces).
    addMomentum(int(round(value * float(count) * (velocityScale / weightScale))), index, face, true);
}

void depositV(ivec2 face, float weight, float value) {
    if (weight <= 0.0) {
        return;
    }
    if (face.x < 0 || face.x >= gridSize.x || face.y < 0 || face.y > gridSize.y) {
        return;
    }
    ivec2 downCell = ivec2(face.x, face.y - 1);
    ivec2 upCell = ivec2(face.x, face.y);
    if (face.y == 0 || face.y == gridSize.y || blockedCell(downCell) || blockedCell(upCell)) {
        return;
    }

    int index = vFaceIndex(face);
    uint count = uint(round(weight * weightScale));
    addCount(count, index, face, 2);
    // Quantized-weight momentum, as in depositU.
    addMomentum(int(round(value * float(count) * (velocityScale / weightScale))), index, face, false);
}

// Reads and validates a record; false when it deposits nothing.
bool loadParticle(uint index, out vec2 position, out vec2 velocity, out float mass, out mat2 affine) {
    position = vec2(0.0);
    velocity = vec2(0.0);
    mass = 0.0;
    affine = mat2(0.0);
    if (index >= uint(maxParticles)) {
        return false;
    }

    WaterParticle particle = particles[index];
    if (invalidFloat(particle.state1.x)) {
        atomicAdd(nanInfDetected, 1u);
        return false;
    }
    if (particle.state1.x < 0.5) {
        return false;
    }

    position = particle.state0.xy;
    velocity = particle.state0.zw;
    mass = particle.state1.y;
    affine = mat2(vec2(particle.state1.z, particle.state1.w), vec2(particle.state2.x, particle.state2.y));
    if (invalidVec2(position) || invalidVec2(velocity) || invalidMat2(affine) || invalidFloat(mass) || mass <= 0.0 ||
        any(lessThan(position, vec2(0.0))) || any(greaterThanEqual(position, vec2(gridSize)))) {
        atomicAdd(nanInfDetected, 1u);
        return false;
    }
    // A particle caught inside sand or a wall waits for the step to free it; its zero-momentum weight would
    // brake the water around it.
    if (blockedCell(ivec2(floor(position)))) {
        return false;
    }
    vec2 maxMomentum = (abs(velocity) + 1.5 * (abs(affine[0]) + abs(affine[1]))) * mass * velocityScale;
    if (invalidVec2(maxMomentum) || any(greaterThan(maxMomentum, vec2(2147483520.0))) ||
        mass * weightScale > 4294967040.0) {
        atomicAdd(particleOverflowBlocked, 1u);
        return false;
    }
    return true;
}

void deposit(vec2 position, vec2 velocity, float mass, mat2 affine) {
    vec2 cellSample = position - vec2(0.5);
    ivec2 cellBase = ivec2(floor(cellSample));
    vec2 cellFrac = fract(cellSample);
    // Bilinear weight that lands in a wall cell goes to the particle's own cell, so a film against a wall keeps its density.
    float displaced = 0.0;
    for (int j = 0; j < 2; ++j) {
        for (int i = 0; i < 2; ++i) {
            ivec2 cell = cellBase + ivec2(i, j);
            float weight = mass * (i == 1 ? cellFrac.x : 1.0 - cellFrac.x) * (j == 1 ? cellFrac.y : 1.0 - cellFrac.y);
            if (blockedCell(cell)) {
                displaced += weight;
            } else {
                depositCell(cell, weight);
            }
        }
    }
    depositCell(ivec2(floor(position)), displaced);

    vec2 uSample = position - vec2(0.0, 0.5);
    ivec2 uBase = ivec2(floor(uSample - vec2(0.5)));
    vec2 uFx = uSample - vec2(uBase);
    vec3 uWx;
    vec3 uWy;
    quadraticWeights(uFx.x, uWx);
    quadraticWeights(uFx.y, uWy);

    for (int j = 0; j < 3; ++j) {
        for (int i = 0; i < 3; ++i) {
            ivec2 face = uBase + ivec2(i, j);
            vec2 facePos = vec2(float(face.x), float(face.y) + 0.5);
            vec2 apicVelocity = velocity + affine * (facePos - position);
            depositU(face, mass * uWx[i] * uWy[j], apicVelocity.x);
        }
    }

    vec2 vSample = position - vec2(0.5, 0.0);
    ivec2 vBase = ivec2(floor(vSample - vec2(0.5)));
    vec2 vFx = vSample - vec2(vBase);
    vec3 vWx;
    vec3 vWy;
    quadraticWeights(vFx.x, vWx);
    quadraticWeights(vFx.y, vWy);

    for (int j = 0; j < 3; ++j) {
        for (int i = 0; i < 3; ++i) {
            ivec2 face = vBase + ivec2(i, j);
            vec2 facePos = vec2(float(face.x) + 0.5, float(face.y));
            vec2 apicVelocity = velocity + affine * (facePos - position);
            depositV(face, mass * vWx[i] * vWy[j], apicVelocity.y);
        }
    }
}

void flushCount(uint count, int globalIndex, int kind) {
    if (count == 0u) return;
    uint previous;
    if (kind == 0) previous = atomicAdd(cellCounts[globalIndex], count);
    else if (kind == 1) previous = atomicAdd(uWeights[globalIndex], count);
    else previous = atomicAdd(vWeights[globalIndex], count);
    if (previous > 0xffffffffu - count) atomicAdd(particleOverflowBlocked, 1u);
}

// Adds a tile's (low word, wrap count) sum to the grid's, carrying the low word's wrap as a deposit does.
void flushSum(ivec2 sum, int globalIndex, bool uFace) {
    if (sum == ivec2(0)) return;
    int carry = signedCarry(uFace ? atomicAdd(uVelocitySums[globalIndex].x, sum.x)
                                  : atomicAdd(vVelocitySums[globalIndex].x, sum.x), sum.x);
    int high = sum.y + carry;
    if (high == 0) return;
    if (uFace) atomicAdd(uVelocitySums[globalIndex].y, high);
    else atomicAdd(vVelocitySums[globalIndex].y, high);
}

void main() {
    uint local = gl_LocalInvocationIndex;
    vec2 position, velocity;
    float mass;
    mat2 affine;
    bool deposits = loadParticle(gl_GlobalInvocationID.x, position, velocity, mass, affine);

    if (local == 0u) {
        tileMin = ivec2(2147483647);
        tileMax = ivec2(-2147483647);
    }
    for (int t = int(local); t < kTileCells; t += 256) {
        tileCells[t] = 0u;
        tileUWeights[t] = 0u;
        tileVWeights[t] = 0u;
        tileUSums[t] = ivec2(0);
        tileVSums[t] = ivec2(0);
    }
    barrier();
    if (deposits) {
        ivec2 cell = ivec2(floor(position));
        atomicMin(tileMin.x, cell.x);
        atomicMin(tileMin.y, cell.y);
        atomicMax(tileMax.x, cell.x);
        atomicMax(tileMax.y, cell.y);
    }
    barrier();
    ivec2 span = tileMax - tileMin;
    if (span.x < 0) return;  // no particle deposits (uniform across the workgroup)
    useTile = all(lessThanEqual(span, ivec2(kTile - 4)));
    tileOrigin = tileMin - ivec2(1);

    if (deposits) deposit(position, velocity, mass, affine);
    if (!useTile) return;  // uniform
    barrier();

    for (int t = int(local); t < kTileCells; t += 256) {
        ivec2 coord = tileOrigin + ivec2(t % kTile, t / kTile);
        // Only entries a deposit reached are nonzero, and deposits check their own ranges.
        flushCount(tileCells[t], cellIndex(coord), 0);
        if (tileUWeights[t] != 0u || tileUSums[t] != ivec2(0)) {
            int index = uFaceIndex(coord);
            flushCount(tileUWeights[t], index, 1);
            flushSum(tileUSums[t], index, true);
        }
        if (tileVWeights[t] != 0u || tileVSums[t] != ivec2(0)) {
            int index = vFaceIndex(coord);
            flushCount(tileVWeights[t], index, 2);
            flushSum(tileVSums[t], index, false);
        }
    }
}
