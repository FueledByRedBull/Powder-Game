#version 430

layout(local_size_x = 256) in;

struct SandParticle {
    vec4 state0;
    vec4 state1;
    vec4 state2;
    vec4 state3;
};

layout(std430, binding = 0) readonly buffer SandParticlesSrc {
    SandParticle srcParticles[];
};

layout(std430, binding = 1) buffer SandParticlesDst {
    SandParticle dstParticles[];
};

layout(std430, binding = 2) buffer SandSpawnCursor {
    uint spawnCursor;
};

uniform int maxParticles;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uint(maxParticles)) {
        return;
    }

    SandParticle particle = srcParticles[index];
    if (particle.state1.x < 0.5) {
        return;
    }

    uint dstIndex = atomicAdd(spawnCursor, 1u);
    if (dstIndex >= uint(maxParticles)) {
        return;
    }
    dstParticles[dstIndex] = particle;
}
