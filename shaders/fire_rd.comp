#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(r16f, binding = 0) uniform readonly image2D fuelSrc;
layout(r16f, binding = 1) uniform readonly image2D oxidizerSrc;
layout(r16f, binding = 2) uniform readonly image2D temperatureSrc;
layout(r16f, binding = 3) uniform readonly image2D smokeSrc;
layout(r8ui, binding = 4) uniform readonly uimage2D boundaryTex;
layout(rg16f, binding = 5) uniform readonly image2D reactionSrc;
layout(r16f, binding = 6) uniform writeonly image2D fuelDst;
layout(r16f, binding = 7) uniform writeonly image2D oxidizerDst;
layout(r16f, binding = 8) uniform writeonly image2D temperatureDst;
layout(rg16f, binding = 9) uniform writeonly image2D reactionDst;
layout(r16f, binding = 10) uniform writeonly image2D smokeDst;

layout(std430, binding = 7) buffer DebugCounters {
    uint nanInfDetected;
    uint particleOverflowBlocked;
    uint pressureNonconverged;
    uint inactiveTileMisses;
};

uniform ivec2 gridSize;
uniform float dt;
uniform float combustionRate;
uniform float oxidizerConsumption;
uniform float reactionDecay;
uniform float temperatureDiffusion;
uniform float temperatureCooling;
uniform float heatRelease;
uniform float smokeYield;
uniform float smokeDissipation;

ivec2 clampGrid(ivec2 coord) {
    return clamp(coord, ivec2(0), gridSize - ivec2(1));
}

float fuelAt(ivec2 coord) {
    return imageLoad(fuelSrc, clampGrid(coord)).x;
}

float oxidizerAt(ivec2 coord) {
    return imageLoad(oxidizerSrc, clampGrid(coord)).x;
}

float temperatureAt(ivec2 coord) {
    return imageLoad(temperatureSrc, clampGrid(coord)).x;
}

float smokeAt(ivec2 coord) {
    return imageLoad(smokeSrc, clampGrid(coord)).x;
}

vec2 reactionAt(ivec2 coord) {
    return imageLoad(reactionSrc, clampGrid(coord)).xy;
}

bool invalid(float value) {
    return isnan(value) || isinf(value);
}

bool fluidAt(ivec2 coord) {
    return all(greaterThanEqual(coord, ivec2(0))) && all(lessThan(coord, gridSize)) &&
           imageLoad(boundaryTex, coord).r == 0u;
}

float laplacianTemperature(ivec2 coord, float center) {
    float laplacian = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            if ((x == 0 && y == 0) || !fluidAt(coord + ivec2(x, y))) continue;
            bool diagonal = x != 0 && y != 0;
            // No flux through solids, including a diagonal between sealed corners.
            if (diagonal && (!fluidAt(coord + ivec2(x, 0)) || !fluidAt(coord + ivec2(0, y)))) continue;
            laplacian += (diagonal ? 0.05 : 0.2) * (temperatureAt(coord + ivec2(x, y)) - center);
        }
    }
    return laplacian;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= gridSize.x || coord.y >= gridSize.y) {
        return;
    }

    if (imageLoad(boundaryTex, coord).r != 0u) {
        imageStore(reactionDst, coord, vec4(0.0));
        imageStore(fuelDst, coord, vec4(0.0));
        imageStore(oxidizerDst, coord, vec4(0.0));
        imageStore(temperatureDst, coord, vec4(0.0));
        imageStore(smokeDst, coord, vec4(0.0));
        return;
    }

    float fuel = fuelAt(coord);
    float oxidizer = oxidizerAt(coord);
    float temperature = temperatureAt(coord);
    float smokeDensity = smokeAt(coord);
    float reaction = reactionAt(coord).y;
    float ignition = smoothstep(0.18, 0.55, max(temperature, reaction));
    float consumed = min(combustionRate * dt * fuel * oxidizer * ignition, fuel);
    if (oxidizerConsumption > 0.0) consumed = min(consumed, oxidizer / oxidizerConsumption);
    float lapTemperature = laplacianTemperature(coord, temperature);

    fuel = clamp(fuel - consumed, 0.0, 1.0);
    oxidizer = clamp(oxidizer - consumed * oxidizerConsumption, 0.0, 1.0);
    reaction = clamp(reaction + consumed - reactionDecay * reaction * dt, 0.0, 1.0);
    temperature = clamp(temperature + consumed * heatRelease +
                            (temperatureDiffusion * lapTemperature - temperatureCooling * temperature) * dt,
                        0.0,
                        1.0);
    smokeDensity = clamp(smokeDensity + consumed * smokeYield - smokeDissipation * smokeDensity * dt, 0.0, 1.0);
    if (invalid(fuel) || invalid(oxidizer) || invalid(temperature) || invalid(reaction) || invalid(smokeDensity)) {
        atomicAdd(nanInfDetected, 1u);
        fuel = 0.0;
        oxidizer = 0.0;
        temperature = 0.0;
        reaction = 0.0;
        smokeDensity = 0.0;
    }

    imageStore(fuelDst, coord, vec4(fuel, 0.0, 0.0, 0.0));
    imageStore(oxidizerDst, coord, vec4(oxidizer, 0.0, 0.0, 0.0));
    imageStore(temperatureDst, coord, vec4(temperature, 0.0, 0.0, 0.0));
    imageStore(reactionDst, coord, vec4(0.0, reaction, 0.0, 0.0));
    imageStore(smokeDst, coord, vec4(smokeDensity, 0.0, 0.0, 0.0));
}
