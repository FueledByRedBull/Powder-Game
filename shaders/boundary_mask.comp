#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(r16f, binding = 0) uniform readonly image2D boundarySdfTex;
layout(r8ui, binding = 1) uniform writeonly uimage2D boundaryMaskTex;

uniform ivec2 gridSize;
uniform float solidThreshold;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= gridSize.x || coord.y >= gridSize.y) {
        return;
    }

    float sdf = imageLoad(boundarySdfTex, coord).x;
    uint blocked = sdf <= solidThreshold ? 1u : 0u;
    imageStore(boundaryMaskTex, coord, uvec4(blocked, 0u, 0u, 0u));
}
