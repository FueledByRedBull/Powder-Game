#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(r16ui, binding = 0) uniform uimage2D materialTex;
layout(r16f, binding = 3) uniform image2D waterAmountTex;
layout(rg16f, binding = 4) uniform image2D waterVelocityTex;
layout(r16f, binding = 5) uniform image2D gasTemperatureTex;
layout(rg16f, binding = 6) uniform image2D gasReactionTex;
// Sleeping sand grains per cell: erased and walled over like the moving grains.
layout(r8ui, binding = 7) uniform uimage2D sandPackedTex;
// Packed calm water per cell (water_pack.comp): cleared with the water.
layout(r8ui, binding = 1) uniform uimage2D waterPackedTex;

uniform ivec2 gridSize;
uniform ivec2 dispatchOrigin;
uniform ivec2 brushCenter;
uniform int brushRadius;
uniform int replaceMaterial;
uniform uint materialValue;
uniform int blockedBySolid;
uniform int blockedByWater;
uniform int clearWater;
uniform int clearMode;

bool insideBrush(ivec2 coord) {
    vec2 cell_center = vec2(coord) + vec2(0.5);
    vec2 brush_center = vec2(brushCenter) + vec2(0.5);
    vec2 delta = cell_center - brush_center;
    return dot(delta, delta) <= float(brushRadius * brushRadius);
}

bool hasWater(ivec2 coord) {
    return imageLoad(waterAmountTex, coord).x > 0.015;
}

void resetWater(ivec2 coord) {
    imageStore(waterAmountTex, coord, vec4(0.0));
    imageStore(waterVelocityTex, coord, vec4(0.0));
    imageStore(waterPackedTex, coord, uvec4(0u));
}

void main() {
    ivec2 coord = dispatchOrigin + ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= gridSize.x || coord.y >= gridSize.y) {
        return;
    }
    if (!insideBrush(coord)) {
        return;
    }

    uint current_material = imageLoad(materialTex, coord).r;
    bool solid = current_material >= 2u;  // rock or wood
    bool water = hasWater(coord);

    if (clearMode == 1) {
        imageStore(materialTex, coord, uvec4(0u));
        imageStore(sandPackedTex, coord, uvec4(0u));
        resetWater(coord);
        imageStore(gasTemperatureTex, ivec2(coord / 2), vec4(0.0));
        imageStore(gasReactionTex, ivec2(coord / 2), vec4(0.0));
        return;
    }

    if (blockedBySolid == 1 && solid) {
        return;
    }
    if (blockedByWater == 1 && water) {
        return;
    }

    if (replaceMaterial == 1) {
        imageStore(materialTex, coord, uvec4(materialValue, 0u, 0u, 0u));
    }

    if (clearWater == 1 || (replaceMaterial == 1 && materialValue != 0u)) {
        resetWater(coord);
    }
    if (replaceMaterial == 1 && materialValue != 0u) {
        imageStore(sandPackedTex, coord, uvec4(0u));
    }
}
