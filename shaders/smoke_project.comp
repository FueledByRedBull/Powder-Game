#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(r16f, binding = 0) uniform readonly image2D gasUSrc;
layout(r16f, binding = 1) uniform readonly image2D gasVSrc;
layout(r32f, binding = 2) uniform readonly image2D pressureTex;
layout(r16f, binding = 3) uniform writeonly image2D gasUDst;
layout(r16f, binding = 4) uniform writeonly image2D gasVDst;
layout(r8ui, binding = 5) uniform readonly uimage2D boundaryTex;

layout(std430, binding = 7) buffer DebugCounters {
    uint nanInfDetected;
    uint particleOverflowBlocked;
    uint pressureNonconverged;
    uint inactiveTileMisses;
};

uniform ivec2 gasSize;

float pressureAt(ivec2 coord) {
    coord = clamp(coord, ivec2(0), gasSize - ivec2(1));
    if (imageLoad(boundaryTex, coord).r != 0u) {
        return 0.0;
    }
    return imageLoad(pressureTex, coord).x;
}

bool blockedCell(ivec2 coord) {
    return coord.x < 0 || coord.y < 0 || coord.x >= gasSize.x || coord.y >= gasSize.y || imageLoad(boundaryTex, coord).r != 0u;
}

bool invalid(float value) {
    return isnan(value) || isinf(value);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);

    if (coord.x <= gasSize.x && coord.y < gasSize.y) {
        float value = 0.0;
        if (coord.x > 0 && coord.x < gasSize.x && !blockedCell(ivec2(coord.x - 1, coord.y)) &&
            !blockedCell(ivec2(coord.x, coord.y))) {
            value = imageLoad(gasUSrc, coord).x - (pressureAt(ivec2(coord.x, coord.y)) - pressureAt(ivec2(coord.x - 1, coord.y)));
            if (invalid(value)) {
                atomicAdd(nanInfDetected, 1u);
                value = 0.0;
            }
        }
        imageStore(gasUDst, coord, vec4(value, 0.0, 0.0, 0.0));
    }

    if (coord.x < gasSize.x && coord.y <= gasSize.y) {
        float value = 0.0;
        if (coord.y > 0 && coord.y < gasSize.y && !blockedCell(ivec2(coord.x, coord.y - 1)) &&
            !blockedCell(ivec2(coord.x, coord.y))) {
            value = imageLoad(gasVSrc, coord).x - (pressureAt(ivec2(coord.x, coord.y)) - pressureAt(ivec2(coord.x, coord.y - 1)));
            if (invalid(value)) {
                atomicAdd(nanInfDetected, 1u);
                value = 0.0;
            }
        }
        imageStore(gasVDst, coord, vec4(value, 0.0, 0.0, 0.0));
    }
}
