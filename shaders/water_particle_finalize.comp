#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(r8ui, binding = 0) uniform readonly uimage2D boundaryTex;
layout(r16f, binding = 1) uniform writeonly image2D liquidVolumeTex;
layout(r16f, binding = 2) uniform writeonly image2D liquidPhiTex;
layout(r16f, binding = 3) uniform writeonly image2D waterAmountTex;

layout(std430, binding = 0) readonly buffer WaterCellCounts {
    uint counts[];
};

uniform ivec2 gridSize;
uniform float weightScale;
uniform float amountPerParticle;

int linearIndex(ivec2 coord) {
    return coord.y * gridSize.x + coord.x;
}

ivec2 clampCell(ivec2 coord) {
    return clamp(coord, ivec2(0), gridSize - ivec2(1));
}

float particleEquivalentAt(ivec2 coord) {
    ivec2 clamped = clampCell(coord);
    return float(counts[linearIndex(clamped)]) / weightScale;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= gridSize.x || coord.y >= gridSize.y) {
        return;
    }

    if (imageLoad(boundaryTex, coord).r != 0u) {
        imageStore(liquidVolumeTex, coord, vec4(0.0));
        imageStore(liquidPhiTex, coord, vec4(-1.0, 0.0, 0.0, 0.0));
        imageStore(waterAmountTex, coord, vec4(0.0));
        return;
    }

    int cell_index = linearIndex(coord);
    uint weight_sum = counts[cell_index];
    if (weight_sum == 0u) {
        imageStore(liquidVolumeTex, coord, vec4(0.0));
        imageStore(liquidPhiTex, coord, vec4(1.0, 0.0, 0.0, 0.0));
        imageStore(waterAmountTex, coord, vec4(0.0));
        return;
    }

    float local_particle_equivalent = float(weight_sum) / weightScale;

    float filtered_particles = 0.0;
    float filtered_weights = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 sampleCoord = coord + ivec2(x, y);
            float kernel = (x == 0 && y == 0) ? 4.0 : ((x == 0 || y == 0) ? 2.0 : 1.0);
            filtered_particles += particleEquivalentAt(sampleCoord) * kernel;
            filtered_weights += kernel;
        }
    }

    float local_volume = local_particle_equivalent * amountPerParticle;
    float smooth_volume = (filtered_particles / max(filtered_weights, 1.0)) * amountPerParticle * 0.96;
    float liquid_volume = clamp(max(local_volume, mix(local_volume, smooth_volume, 0.45)), 0.0, 1.0);
    float liquid_phi = clamp(0.46 - liquid_volume * 1.18, -1.0, 1.0);
    float water_amount = clamp(mix(liquid_volume, 1.0 - smoothstep(0.06, 0.42, liquid_phi), 0.28), 0.0, 1.0);

    imageStore(liquidVolumeTex, coord, vec4(liquid_volume, 0.0, 0.0, 0.0));
    imageStore(liquidPhiTex, coord, vec4(liquid_phi, 0.0, 0.0, 0.0));
    imageStore(waterAmountTex, coord, vec4(water_amount, 0.0, 0.0, 0.0));
}
