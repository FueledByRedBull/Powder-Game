cmake_minimum_required(VERSION 3.24)

# Writes OUTPUT, a C++ source holding every shader in SHADER_DIR as a byte array that
# glutil::FindEmbeddedShader looks up by file name. Byte arrays avoid MSVC string-literal limits.
file(GLOB shaders LIST_DIRECTORIES false "${SHADER_DIR}/*.comp" "${SHADER_DIR}/*.frag" "${SHADER_DIR}/*.vert")
list(SORT shaders)
if(NOT shaders)
    message(FATAL_ERROR "No shaders found in ${SHADER_DIR}")
endif()

string(REPEAT "0x[0-9a-f][0-9a-f]," 16 row)
set(arrays "")
set(entries "")
set(index 0)
foreach(shader IN LISTS shaders)
    get_filename_component(name "${shader}" NAME)
    file(READ "${shader}" hex HEX)
    if(hex STREQUAL "")
        message(FATAL_ERROR "Empty shader: ${shader}")
    endif()
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "(${row})" "\\1\n" bytes "${bytes}")
    string(APPEND arrays "const unsigned char kShader${index}[] = {\n${bytes}};\n")
    string(APPEND entries "        {\"${name}\", Text(kShader${index}, sizeof(kShader${index}))},\n")
    math(EXPR index "${index} + 1")
endforeach()

file(WRITE "${OUTPUT}" "// Generated by cmake/EmbedShaders.cmake from shaders/; do not edit.
#include <cstddef>
#include <string_view>
#include <utility>

namespace {

${arrays}
std::string_view Text(const unsigned char* data, std::size_t size) {
    return {reinterpret_cast<const char*>(data), size};
}

}  // namespace

namespace glutil {

std::string_view FindEmbeddedShader(std::string_view name) {
    static const std::pair<std::string_view, std::string_view> shaders[] = {
${entries}    };
    for (const auto& [shader_name, source] : shaders) {
        if (shader_name == name) {
            return source;
        }
    }
    return {};
}

}  // namespace glutil
")
